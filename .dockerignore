# Deny by default. Reopen only build-input trees, then exclude sensitive/residue
# files at every depth even inside those trees. Dockerfiles use explicit COPY too.
**
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.json
!apps/
!apps/web/
!apps/api/
!apps/*/package.json
!apps/*/tsconfig.json
!apps/web/next-env.d.ts
!apps/web/next.config.ts
!apps/web/postcss.config.mjs
!apps/*/src/
!apps/*/src/**
!apps/web/public/
!apps/web/public/**
!packages/
!packages/contracts/
!packages/database/
!packages/ui/
!packages/config/
!packages/*/package.json
!packages/*/tsconfig.json
!packages/*/src/
!packages/*/src/**
!packages/database/drizzle/
!packages/database/drizzle/**
**/.git
**/.worktrees
**/node_modules
**/.next
**/dist
**/.env
**/.env.*
**/.npmrc
**/.pnpmfile.cjs
**/*.key
**/*.pem
**/*.p12
**/*.log
**/*.tsbuildinfo
**/secrets
**/data
**/backups
**/uploads
**/evidence
**/PGDATA
