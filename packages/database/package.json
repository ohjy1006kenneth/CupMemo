{
  "name": "@cupmemo/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "types": "./dist/index.d.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/migrate.ts",
    "db:status": "tsx src/status.ts",
    "test:integration": "corepack pnpm build && node scripts/integration.mjs",
    "domain:test:integration": "corepack pnpm build && node scripts/domain-integration.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
