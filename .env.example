# Local environment variables
# Optional API listener overrides. The default host is loopback only.
CUPMEMO_API_HOST=127.0.0.1
CUPMEMO_API_PORT=4101

# Next.js server-side rewrite target. Never expose this as a NEXT_PUBLIC variable.
CUPMEMO_API_ORIGIN=http://127.0.0.1:4101

# Set one explicit mode and its matching dedicated database URL.
# Development: start with:
# docker compose -f infrastructure/docker/database.compose.yml up -d
CUPMEMO_DB_ENV=development
CUPMEMO_DATABASE_URL_DEVELOPMENT=postgresql://cupmemo:cupmemo@127.0.0.1:55432/cupmemo_dev
# For integration tests use CUPMEMO_DB_ENV=test,
# CUPMEMO_DATABASE_URL_TEST=postgresql://.../cupmemo_test_<task>, and
# CUPMEMO_TEST_DATABASE=cupmemo_test_<task> on a disposable local PostgreSQL instance.
# Production uses CUPMEMO_DB_ENV=production and CUPMEMO_DATABASE_URL_PRODUCTION.
# Never put production credentials in this example file.
