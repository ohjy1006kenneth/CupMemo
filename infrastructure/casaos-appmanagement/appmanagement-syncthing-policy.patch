+func TestSyncthingPolicyTransport(t *testing.T) {
+	ctx := context.Background()
+	a := projectSyncthingIdentity(ordinaryPolicyApp())
+	for _, mode := range []string{"allow", "malformed", "trailing", "nonzero", "stdout-overflow", "stderr-overflow", "canceled", "open-failure"} {
+		t.Run(mode, func(t *testing.T) {
+			c, cancel := context.WithCancel(ctx)
+			defer cancel()
+			open := func(path string) (*os.File, error) {
+				if path != syncthingPolicyPath {
+					t.Fatal(path)
+				}
+				if mode == "open-failure" {
+					return nil, os.ErrPermission
+				}
+				return os.Open("testdata/syncthing-manager-policy.mjs")
+			}
+			run := func(cmd *exec.Cmd) error {
+				if cmd.Path != "/usr/bin/node" || !reflect.DeepEqual(cmd.Args, []string{"/usr/bin/node", syncthingPolicyPath, "--check"}) || !reflect.DeepEqual(cmd.Env, []string{"PATH=/usr/bin:/bin", "LANG=C.UTF-8"}) || cmd.WaitDelay != 250*time.Millisecond {
+					t.Fatal("unsafe command")
+				}
+				input, err := io.ReadAll(cmd.Stdin)
+				if err != nil || !bytes.Contains(input, []byte(`"operation":"apply"`)) {
+					t.Fatal("request")
+				}
+				if mode == "canceled" {
+					cancel()
+				}
+				if mode == "nonzero" {
+					return errors.New("SECRET")
+				}
+				if mode == "stdout-overflow" || mode == "stderr-overflow" {
+					var w io.Writer = cmd.Stdout
+					if mode == "stderr-overflow" {
+						w = cmd.Stderr
+					}
+					_, err := io.Copy(w, strings.NewReader(strings.Repeat("x", syncthingPolicyLimit+1)))
+					if err == nil {
+						t.Fatal("uncapped io.Copy")
+					}
+					return err
+				}
+				output := "{\"version\":1,\"allowed\":true}\n"
+				if mode == "malformed" {
+					output = "{}"
+				}
+				if mode == "trailing" {
+					output += "SECRET"
+				}
+				_, err = io.WriteString(cmd.Stdout, output)
+				return err
+			}
+			err := runSyncthingPolicy(c, "apply", a, nil, open, run)
+			if mode == "allow" {
+				if err != nil {
+					t.Fatal(err)
+				}
+			} else {
+				requirePolicyRefusal(t, err)
+			}
+		})
+	}
+	// Actual canceled CommandContext, not merely a fake runner's error.
+	policyFixture(t)
+	c, cancel := context.WithCancel(ctx)
+	cancel()
+	requirePolicyRefusal(t, checkSyncthingPolicy(c, "apply", a, nil))
+	expired, stop := context.WithTimeout(ctx, time.Nanosecond)
+	defer stop()
+	<-expired.Done()
+	requirePolicyRefusal(t, checkSyncthingPolicy(expired, "apply", a, nil))
+}
