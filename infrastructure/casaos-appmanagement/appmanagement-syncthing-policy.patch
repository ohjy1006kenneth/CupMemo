+	// The separate real-helper test exercises the unchanged accepted helper bytes.
+	fixtures := map[string]string{
+		"malformed":       `process.stdout.write('{}');`,
+		"trailing":        `process.stdout.write('{"version":1,"allowed":true}\nSECRET-SENTINEL');`,
