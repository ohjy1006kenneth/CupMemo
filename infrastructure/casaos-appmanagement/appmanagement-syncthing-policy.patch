+
+func cloneFixture() (*types.ContainerJSON, *types.ImageInspect, *types.ImageInspect) {
+	oldID := "sha256:" + strings.Repeat("b", 64)
+	current := &types.ContainerJSON{ContainerJSONBase: &types.ContainerJSONBase{ID: strings.Repeat("a", 64), Name: "/ordinary", Image: oldID, HostConfig: &container.HostConfig{}}, Config: &container.Config{Image: "ordinary:latest", Labels: map[string]string{"inherited": "old", "override": "runtime"}, Env: []string{"SECRET-SENTINEL"}}, NetworkSettings: &types.NetworkSettings{Networks: map[string]*network.EndpointSettings{}}}
+	old := &types.ImageInspect{ID: oldID, Config: &container.Config{Labels: map[string]string{"inherited": "old"}}}
+	target := &types.ImageInspect{ID: "sha256:" + strings.Repeat("c", 64), Config: &container.Config{Labels: map[string]string{"inherited": "target", "override": "default", "com.docker.compose.project": "local-syncthing"}}}
+	return current, old, target
+}
+
+func TestSyncthingRecreateClonePlan(t *testing.T) {
+	c, old, target := cloneFixture()
+	before := c.Config.Labels["inherited"]
+	snapshots, err := json.Marshal([]interface{}{c, old, target})
+	if err != nil {
+		t.Fatal(err)
+	}
+	plan, err := PrepareContainerClone(c, old, target)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := map[string]string{"inherited": "target", "override": "runtime", "com.docker.compose.project": "local-syncthing"}
+	after, err := json.Marshal([]interface{}{c, old, target})
+	if err != nil || string(after) != string(snapshots) {
+		t.Fatal("planning mutated original snapshots")
+	}
+	identity := plan.EffectiveContainer()
+	if identity.ID != c.ID || identity.Name != c.Name || !reflect.DeepEqual(identity.Config.Labels, want) || identity.Config.Env != nil || identity.HostConfig != nil {
+		t.Fatal("incorrect identity-only projection")
+	}
+	identity.Config.Labels["inherited"] = "mutated"
+	identity.Name = "/changed"
+	c.Config.Labels["override"] = "mutated"
+	target.ID = "sha256:" + strings.Repeat("d", 64)
+	target.Config.Labels["inherited"] = "mutated"
+	deps := clonePlanDeps{create: func(ctx context.Context, config *container.Config, host *container.HostConfig, net *network.NetworkingConfig, name string) (string, error) {
+		if config.Image != "sha256:"+strings.Repeat("c", 64) || !reflect.DeepEqual(config.Labels, want) || name != "temporary" {
+			t.Fatal("plan retargeted after admission")
+		}
+		config.Labels["inherited"] = "writer mutation"
+		return "clone", nil
+	}, disconnect: func(context.Context, string, string) error { return nil }, connect: func(context.Context, string, string, *network.EndpointSettings) error { return nil }}
+	if id, err := cloneContainerFromPlan(context.Background(), plan, "temporary", deps); err != nil || id != "clone" {
+		t.Fatal(id, err)
+	}
+	if plan.EffectiveContainer().Config.Labels["inherited"] != "target" || old.Config.Labels["inherited"] != before {
+		t.Fatal("input/plan mutated")
+	}
+}
+
+func TestSyncthingRecreateCloneInvalid(t *testing.T) {
+	for _, alter := range []func(*types.ContainerJSON, *types.ImageInspect, *types.ImageInspect){
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { c.Config = nil },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { c.HostConfig = nil },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { c.NetworkSettings = nil },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { c.ID = "alias" },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { c.Name = "//ordinary" },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { n.ID = "mutable:tag" },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { o.ID = "sha256:" + strings.Repeat("d", 64) },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { n.Config = nil },
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) {
+			n.Config.Labels = map[string]string{"bad": "nul\x00"}
+		},
+		func(c *types.ContainerJSON, o, n *types.ImageInspect) { c.HostConfig.Links = []string{"invalid"} },
+	} {
+		c, o, n := cloneFixture()
+		alter(c, o, n)
+		if _, err := PrepareContainerClone(c, o, n); err == nil {
+			t.Fatal("invalid plan admitted")
+		}
+	}
+	c, o, n := cloneFixture()
+	for _, args := range [][3]interface{}{{nil, o, n}, {c, nil, n}, {c, o, nil}} {
+		var cc *types.ContainerJSON
+		var oo, nn *types.ImageInspect
+		if args[0] != nil {
+			cc = args[0].(*types.ContainerJSON)
+		}
+		if args[1] != nil {
+			oo = args[1].(*types.ImageInspect)
+		}
+		if args[2] != nil {
+			nn = args[2].(*types.ImageInspect)
+		}
+		if _, err := PrepareContainerClone(cc, oo, nn); err == nil {
+			t.Fatal("nil admitted")
+		}
+	}
+	plan, _ := PrepareContainerClone(c, o, n)
+	ctx, cancel := context.WithCancel(context.Background())
+	cancel()
+	called := false
