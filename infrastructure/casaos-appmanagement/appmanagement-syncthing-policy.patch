+func TestSyncthingRecreateStagingCancellation(t *testing.T) {
+	for _, stage := range []string{"initial", "compare", "final"} {
+		for _, parentCancel := range []bool{false, true} {
+			t.Run(stage+map[bool]string{false: "-deadline", true: "-cancel"}[parentCancel], func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+				defer cancel()
+				calls := 0
+				pulls := 0
+				deps := recreationImageDeps{
+					image: func(readCtx context.Context, _ string) (*types.ImageInspect, error) {
+						calls++
+						deadline, ok := readCtx.Deadline()
+						if !ok || time.Until(deadline) > 3*time.Second {
+							t.Fatal("unbounded inspect")
+						}
+						if (stage == "initial" && calls == 1) || (stage == "final" && calls == 2) {
+							if parentCancel {
+								cancel()
+							}
+							<-readCtx.Done()
+							return nil, readCtx.Err()
+						}
+						return &types.ImageInspect{ID: "ordinary"}, nil
+					},
+					compare: func(readCtx context.Context, _ string, _ []string) (bool, error) {
+						if stage == "compare" {
+							if parentCancel {
+								cancel()
+							}
+							<-readCtx.Done()
+							return false, readCtx.Err()
+						}
+						return false, nil
+					},
+					pull: func(context.Context, string, func(context.Context, io.ReadCloser) error) error { pulls++; return nil },
+				}
+				c, old, target := recreateFixture()
+				callsLog := []string{}
+				d := recreateDependencies(t, c, old, target, &callsLog)
+				d.current = func(context.Context, *types.ContainerJSON) error { return nil }
+				d.pull = func(ctx context.Context, name string) (bool, error) { return stageRecreationImage(ctx, name, deps) }
+				started := time.Now()
+				err := recreateContainer(ctx, c.ID, true, true, d)
+				if err != errSyncthingPolicy || time.Since(started) > time.Second {
+					t.Fatal(err, callsLog)
+				}
+				for _, call := range callsLog {
+					if call == "finish" {
+						t.Fatal("clone after cancellation")
+					}
+				}
+				if stage != "final" && pulls != 0 {
+					t.Fatal("pull after failed read")
+				}
+			})
+		}
+	}
+}
