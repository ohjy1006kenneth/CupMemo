+package service
+
+// Admission adapter. Production always binds the fixed helper and real dependencies.
+import (
+	"bytes"
+	"context"
+	stdjson "encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/IceWhaleTech/CasaOS-AppManagement/common"
+	"github.com/IceWhaleTech/CasaOS-AppManagement/pkg/config"
+)
+
+const syncthingPolicyPath = "/usr/local/lib/cupmemo/syncthing-manager-policy.mjs"
+const syncthingPolicyLimit = 64 * 1024
+
+var errSyncthingPolicy = errors.New("Syncthing manager policy refused")
+
+type syncthingIdentity struct {
+	Name         string   `json:"name"`
+	WorkingDir   string   `json:"workingDir"`
+	ComposeFiles []string `json:"composeFiles"`
+	ServiceNames []string `json:"serviceNames"`
+}
+
+type syncthingRequest struct {
+	Version   int                `json:"version"`
+	Operation string             `json:"operation"`
+	Current   *syncthingIdentity `json:"current"`
+	Candidate *syncthingIdentity `json:"candidate"`
+}
+
+func projectSyncthingIdentity(a *ComposeApp) *syncthingIdentity {
+	if a == nil {
+		return nil
+	}
+	i := &syncthingIdentity{a.Name, a.WorkingDir, append([]string{}, a.ComposeFiles...), []string{}}
+	for _, service := range a.Services {
+		i.ServiceNames = append(i.ServiceNames, service.Name)
+	}
+	return i
+}
+
+// No embedded bytes.Buffer: io.Copy must not discover an uncapped promoted ReadFrom.
+type syncthingCappedOutput struct {
+	data    []byte
+	size    int
+	discard bool
+}
+
+func (w *syncthingCappedOutput) Write(p []byte) (int, error) {
+	if len(p) > syncthingPolicyLimit-w.size {
+		return 0, errSyncthingPolicy
+	}
+	w.size += len(p)
+	if !w.discard {
+		w.data = append(w.data, p...)
+	}
+	return len(p), nil
+}
+
+// Walk from an open root using openat, never following a link. All components must
+// remain root-owned and not group/world writable; the helper is a single-link regular file.
+// Descriptors pin validation, but root can still replace trusted paths; not a root sandbox.
+func openTrustedSyncthingPolicy(path string) (*os.File, error) {
+	if path != syncthingPolicyPath {
+		return nil, errSyncthingPolicy
+	}
+	fd, err := syscall.Open("/", syscall.O_RDONLY|syscall.O_DIRECTORY|syscall.O_CLOEXEC|syscall.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, errSyncthingPolicy
+	}
+	f := os.NewFile(uintptr(fd), "/")
+	parts := strings.Split(strings.TrimPrefix(path, "/"), "/")
+	for index := -1; index < len(parts); index++ {
+		if index >= 0 {
+			flags := syscall.O_RDONLY | syscall.O_CLOEXEC | syscall.O_NOFOLLOW | syscall.O_NONBLOCK
+			if index < len(parts)-1 {
+				flags |= syscall.O_DIRECTORY
+			}
+			next, openErr := syscall.Openat(int(f.Fd()), parts[index], flags, 0)
+			f.Close()
+			if openErr != nil {
+				return nil, errSyncthingPolicy
+			}
+			f = os.NewFile(uintptr(next), parts[index])
+		}
+		info, statErr := f.Stat()
+		if statErr != nil {
+			f.Close()
+			return nil, errSyncthingPolicy
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !ok || stat.Uid != 0 || info.Mode().Perm()&0022 != 0 || info.Mode()&(os.ModeSetuid|os.ModeSetgid|os.ModeSticky) != 0 {
+			f.Close()
+			return nil, errSyncthingPolicy
+		}
+		if index == len(parts)-1 {
+			if !info.Mode().IsRegular() || stat.Nlink != 1 || info.Size() <= 0 || info.Size() > syncthingPolicyLimit {
+				f.Close()
+				return nil, errSyncthingPolicy
+			}
+		} else if !info.IsDir() {
+			f.Close()
+			return nil, errSyncthingPolicy
+		}
+	}
+	return f, nil
+}
+
+func checkSyncthingPolicy(ctx context.Context, operation string, current, candidate *syncthingIdentity) error {
+	return runSyncthingPolicy(ctx, operation, current, candidate, openTrustedSyncthingPolicy, func(cmd *exec.Cmd) error { return cmd.Run() })
+}
+
+// Explicit package-private dependencies permit transport tests without runtime hooks.
+func runSyncthingPolicy(ctx context.Context, operation string, current, candidate *syncthingIdentity, open func(string) (*os.File, error), run func(*exec.Cmd) error) error {
+	input, err := stdjson.Marshal(syncthingRequest{1, operation, current, candidate})
+	if err != nil || len(input) > syncthingPolicyLimit {
+		return errSyncthingPolicy
+	}
+	helper, err := open(syncthingPolicyPath)
+	if err != nil {
+		return errSyncthingPolicy
+	}
+	defer helper.Close()
+	boundedCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(boundedCtx, "/usr/bin/node", syncthingPolicyPath, "--check")
+	cmd.Env = []string{"PATH=/usr/bin:/bin", "LANG=C.UTF-8"}
+	cmd.Stdin = bytes.NewReader(input)
+	stdout := &syncthingCappedOutput{}
+	stderr := &syncthingCappedOutput{discard: true}
+	cmd.Stdout, cmd.Stderr = stdout, stderr
+	cmd.WaitDelay = 250 * time.Millisecond
+	if err := run(cmd); err != nil || boundedCtx.Err() != nil || !bytes.Equal(stdout.data, []byte("{\"version\":1,\"allowed\":true}\n")) {
+		return errSyncthingPolicy
+	}
+	return nil
+}
+
+// CheckMutation is the safe route-level admission; no bypass flag or injected runtime.
+// CURRENT always comes from the resolved ComposeApp, not the caller's request id.
+func (a *ComposeApp) CheckMutation(ctx context.Context, operation string, candidate *ComposeApp) error {
+	return checkSyncthingPolicy(ctx, operation, projectSyncthingIdentity(a), projectSyncthingIdentity(candidate))
+}
+
+// CURRENT refuses before the upstream parser (which may allocate temporary parser state).
+// The candidate is the existing effective parser model, projected onto its final paths,
+// never a declaration loaded only AFTER overwriting the persistent config.
+func (a *ComposeApp) CheckReplacement(ctx context.Context, operation string, content []byte) error {
+	return checkSyncthingReplacement(ctx, operation, a, content, productionSyncthingDependencies())
+}
+
+type syncthingDependencies struct {
+	check func(context.Context, string, *syncthingIdentity, *syncthingIdentity) error
+	parse func([]byte, bool, bool) (*ComposeApp, error)
+	lstat func(string) (os.FileInfo, error)
+	load  func(string, string) (*ComposeApp, error)
+}
+
+func productionSyncthingDependencies() syncthingDependencies {
+	return syncthingDependencies{checkSyncthingPolicy, NewComposeAppFromYAML, os.Lstat, LoadComposeAppFromConfigFile}
+}
+
+func checkSyncthingReplacement(ctx context.Context, operation string, a *ComposeApp, content []byte, d syncthingDependencies) error {
+	if err := d.check(ctx, operation, projectSyncthingIdentity(a), nil); err != nil {
+		return err
+	}
+	candidate, err := d.parse(content, true, true)
+	if err != nil || candidate == nil || a == nil {
+		return errSyncthingPolicy
+	}
+	candidate.WorkingDir = a.WorkingDir
+	candidate.ComposeFiles = append([]string{}, a.ComposeFiles...)
+	return d.check(ctx, operation, projectSyncthingIdentity(a), projectSyncthingIdentity(candidate))
+}
+
+// Admission before any install mkdir/write/async work. Candidate first; then
+// resolve installed CURRENT at the actual overwrite destination without Docker.
+// Unknown load state cannot silently become permission to overwrite.
+func (s *ComposeService) CheckInstall(ctx context.Context, candidate *ComposeApp) error {
+	return checkSyncthingInstall(ctx, candidate, config.AppInfo.AppsPath, productionSyncthingDependencies())
+}
+
+func checkSyncthingInstall(ctx context.Context, candidate *ComposeApp, appsPath string, d syncthingDependencies) error {
+	if candidate == nil {
+		return errSyncthingPolicy
+	}
+	projected := *candidate
+	projected.WorkingDir = filepath.Join(appsPath, candidate.Name)
+	projected.ComposeFiles = []string{filepath.Join(projected.WorkingDir, common.ComposeYAMLFileName)}
+	if err := d.check(ctx, "install", projectSyncthingIdentity(&projected), projectSyncthingIdentity(candidate)); err != nil {
+		return err
+	}
+	return resolveSyncthingDestination(ctx, "install", projectSyncthingIdentity(&projected), projectSyncthingIdentity(&projected), d)
+}
+
+// PrepareWorkingDirectory has no model argument; resolve any existing CURRENT
+// declaration as well, rather than reducing protected identity to a request name.
+func checkSyncthingDestination(ctx context.Context, operation string, projected, candidate *syncthingIdentity) error {
+	return resolveSyncthingDestination(ctx, operation, projected, candidate, productionSyncthingDependencies())
+}
+
+func resolveSyncthingDestination(ctx context.Context, operation string, projected, candidate *syncthingIdentity, d syncthingDependencies) error {
+	if err := d.check(ctx, operation, projected, candidate); err != nil {
+		return err
+	}
+	if projected == nil || len(projected.ComposeFiles) != 1 {
+		return errSyncthingPolicy
+	}
+	// Do not use List: it silently skips malformed installed declarations.
+	// Resolve an existing declaration at the actual overwrite destination directly.
+	info, err := d.lstat(projected.ComposeFiles[0])
+	if err == nil {
+		if !info.Mode().IsRegular() {
+			return errSyncthingPolicy
+		}
+		current, loadErr := d.load(projected.Name, projected.ComposeFiles[0])
+		if loadErr != nil {
+			return errSyncthingPolicy
+		}
+		return d.check(ctx, operation, projectSyncthingIdentity(current), candidate)
+	}
+	if !os.IsNotExist(err) {
+		return errSyncthingPolicy
+	}
+	return nil
+}
+
