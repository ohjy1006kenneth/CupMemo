+	"github.com/IceWhaleTech/CasaOS-AppManagement/pkg/docker"
+	"github.com/docker/docker/api/types"
+)
+
+// CheckContainerRecreation checks CURRENT only; effective admission is private.
+func CheckContainerRecreation(ctx context.Context, inspected *types.ContainerJSON) error {
+	return checkRecreationIdentity(ctx, inspected, checkSyncthingPolicy)
+}
+
+func checkRecreationIdentity(ctx context.Context, inspected *types.ContainerJSON, check func(context.Context, string, *syncthingIdentity, *syncthingIdentity) error) error {
+	if ctx.Err() != nil {
+		return errSyncthingPolicy
+	}
+	identities, err := legacyIdentities(inspected)
+	if err != nil {
+		return errSyncthingPolicy
+	}
+	for _, identity := range identities {
+		if check(ctx, "container-recreate", identity, nil) != nil {
+			return errSyncthingPolicy
+		}
+	}
+	return nil
+}
+
+func checkRecreationCandidate(ctx context.Context, candidate *types.ContainerJSON) error {
+	return checkRecreationIdentity(ctx, candidate, checkSyncthingPolicy)
+}
+
+type recreateDeps struct {
+	inspect   func(context.Context, string) (*types.ContainerJSON, error)
+	image     func(context.Context, string) (*types.ImageInspect, error)
+	pull      func(context.Context, string) (bool, error)
+	current   func(context.Context, *types.ContainerJSON) error
+	effective func(context.Context, *types.ContainerJSON) error
+	finish    func(context.Context, *types.ContainerJSON, *docker.ContainerClonePlan) error
+}
+
+func recreateContainer(ctx context.Context, id string, pull, force bool, deps recreateDeps) error {
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Minute)
+	defer cancel()
+	readCtx, readCancel := context.WithTimeout(ctx, 3*time.Second)
+	current, err := deps.inspect(readCtx, id)
+	readFailed := readCtx.Err() != nil
+	readCancel()
+	if err != nil || readFailed || current == nil || current.ContainerJSONBase == nil || current.ID != id || deps.current(ctx, current) != nil {
+		return errSyncthingPolicy
+	}
+	updated := false
+	if ctx.Err() != nil {
+		return errSyncthingPolicy
+	}
+	if pull {
+		if current.Config == nil || current.Config.Image == "" {
+			return errSyncthingPolicy
+		}
+		updated, err = deps.pull(ctx, docker.ImageName(current))
+		if err != nil {
+			return err
+		}
+	}
+	if ctx.Err() != nil {
+		return errSyncthingPolicy
+	}
+	if !force && !updated {
+		return nil
+	}
+	if current.State == nil {
+		return errSyncthingPolicy
+	}
+	readImage := func(ref string) (*types.ImageInspect, error) {
+		readCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+		defer cancel()
+		image, err := deps.image(readCtx, ref)
+		if err != nil || readCtx.Err() != nil {
+			return nil, errSyncthingPolicy
+		}
+		return image, nil
+	}
+	// Exactly one target-reference lookup after optional image staging.
+	target, err := readImage(docker.ImageName(current))
+	if err != nil {
+		return errSyncthingPolicy
+	}
+	old, err := readImage(current.Image)
+	if err != nil {
+		return errSyncthingPolicy
+	}
+	plan, err := docker.PrepareContainerClone(current, old, target)
+	if err != nil || deps.effective(ctx, plan.EffectiveContainer()) != nil || ctx.Err() != nil {
+		return errSyncthingPolicy
+	}
+	return deps.finish(ctx, current, plan)
+}
