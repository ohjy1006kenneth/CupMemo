+package service
+
+import (
+	"context"
+	"path/filepath"
+	"regexp"
+	"strings"
+
+	"github.com/IceWhaleTech/CasaOS-AppManagement/model"
+	"github.com/docker/docker/api/types"
+)
+
+var legacyName = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,254}$`)
+var legacyID = regexp.MustCompile(`^[a-f0-9]{64}$`)
+
+// CheckLegacyContainerMutation binds the same fixed trusted transport as ComposeApp.
+// Only selected identity fields are projected; Config.Env and raw inspect never leave Go.
+func CheckLegacyContainerMutation(ctx context.Context, operation string, inspected *types.ContainerJSON, candidate *model.CustomizationPostData) error {
+	return checkLegacyContainerMutation(ctx, operation, inspected, candidate, checkSyncthingPolicy)
+}
+
+func legacyIdentities(inspected *types.ContainerJSON) ([]*syncthingIdentity, error) {
+	if inspected == nil || inspected.ContainerJSONBase == nil || inspected.Config == nil || !legacyID.MatchString(inspected.ID) || !strings.HasPrefix(inspected.Name, "/") {
+		return nil, errSyncthingPolicy
+	}
+	containerName := strings.TrimPrefix(inspected.Name, "/")
+	if !legacyName.MatchString(containerName) {
+		return nil, errSyncthingPolicy
+	}
+	labels := inspected.Config.Labels
+	names := []string{containerName}
+	services := []string{containerName}
+	for _, key := range []string{"com.docker.compose.project", "name"} {
+		if value, present := labels[key]; present {
+			if !legacyName.MatchString(value) {
+				return nil, errSyncthingPolicy
+			}
+			names = append(names, value)
+			if value != containerName {
+				services = append(services, value)
+			}
+		}
+	}
+	if value, present := labels["com.docker.compose.service"]; present {
+		if !legacyName.MatchString(value) || labels["com.docker.compose.project"] == "" {
+			return nil, errSyncthingPolicy
+		}
+		services = append(services, value)
+	}
+	// Deduplicate markers without dropping distinct identities.
+	unique := []string{}
+	for _, value := range services {
+		found := false
+		for _, previous := range unique {
+			if value == previous {
+				found = true
+			}
+		}
+		if !found {
+			unique = append(unique, value)
+		}
+	}
+	working := ""
+	if value, present := labels["com.docker.compose.project.working_dir"]; present {
+		if !legacyPath(value) || labels["com.docker.compose.project"] == "" {
+			return nil, errSyncthingPolicy
+		}
+		working = value
+	}
+	files := []string{}
+	if value, present := labels["com.docker.compose.project.config_files"]; present {
+		if len(value) == 0 || len(value) > 16384 || labels["com.docker.compose.project"] == "" {
+			return nil, errSyncthingPolicy
+		}
+		files = strings.Split(value, ",")
+		if len(files) > 128 {
+			return nil, errSyncthingPolicy
+		}
+		seen := map[string]bool{}
+		for _, filename := range files {
+			if !legacyPath(filename) || seen[filename] {
+				return nil, errSyncthingPolicy
+			}
+			seen[filename] = true
+		}
+	}
+	result := []*syncthingIdentity{}
+	for _, name := range names {
+		result = append(result, &syncthingIdentity{name, working, files, unique})
+	}
+	return result, nil
+}
+
+func legacyPath(value string) bool {
+	if len(value) == 0 || len(value) > 4096 || !strings.HasPrefix(value, "/") || filepath.Clean(value) != value || strings.ContainsAny(value, "\\,") {
+		return false
+	}
+	for _, c := range value {
+		if c < 32 || c > 126 {
+			return false
+		}
+	}
+	return true
+}
+
+func checkLegacyContainerMutation(ctx context.Context, operation string, inspected *types.ContainerJSON, candidate *model.CustomizationPostData, check func(context.Context, string, *syncthingIdentity, *syncthingIdentity) error) error {
+	switch operation {
+	case "legacy-update", "legacy-uninstall", "legacy-archive", "legacy-terminal":
+	default:
+		return errSyncthingPolicy
+	}
+	if ctx.Err() != nil || (candidate != nil && operation != "legacy-update") {
+		return errSyncthingPolicy
+	}
+	current, err := legacyIdentities(inspected)
+	if err != nil {
+		return errSyncthingPolicy
+	}
+	for _, identity := range current {
+		if check(ctx, operation, identity, nil) != nil {
+			return errSyncthingPolicy
+		}
+	}
+	if candidate == nil {
+		return nil
+	}
+	// CreateContainer inherits Config/HostConfig and compose labels, overwrites
+	// legacy label "name", and uses ContainerName as the new Docker name.
+	if !legacyName.MatchString(candidate.ContainerName) || !legacyName.MatchString(candidate.Label) {
+		return errSyncthingPolicy
+	}
+	base := *inspected.ContainerJSONBase
+	base.Name = "/" + candidate.ContainerName
+	config := *inspected.Config
+	config.Labels = map[string]string{}
+	for _, key := range []string{"com.docker.compose.project", "com.docker.compose.service", "com.docker.compose.project.working_dir", "com.docker.compose.project.config_files"} {
+		if value, present := inspected.Config.Labels[key]; present {
+			config.Labels[key] = value
+		}
+	}
+	config.Labels["name"] = candidate.Label
+	effective := &types.ContainerJSON{ContainerJSONBase: &base, Config: &config}
+	projected, err := legacyIdentities(effective)
+	if err != nil {
+		return errSyncthingPolicy
+	}
+	for _, identity := range projected {
+		if check(ctx, operation, current[0], identity) != nil {
+			return errSyncthingPolicy
+		}
+	}
+	return nil
+}
