+			image: func(ctx context.Context, _ string) (*types.ImageInspect, error) {
+				calls++
+				if calls == blocked {
+					<-ctx.Done()
+					return nil, ctx.Err()
+				}
+				return &types.ImageInspect{ID: "ordinary"}, nil
+			},
+			compare: func(context.Context, string, []string) (bool, error) { return false, nil },
+			pull:    func(context.Context, string, func(context.Context, io.ReadCloser) error) error { return nil },
+		})
+		if err != errSyncthingPolicy || time.Since(started) > 4*time.Second {
+			t.Fatal("missing actual 3s inspect bound", err)
+		}
+	}
+}
