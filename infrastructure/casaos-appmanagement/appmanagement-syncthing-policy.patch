+package service
+
+import (
+	"context"
+	"fmt"
+	"io"
+	"strings"
+	"time"
+
+	"github.com/IceWhaleTech/CasaOS-AppManagement/common"
+	"github.com/IceWhaleTech/CasaOS-AppManagement/pkg/docker"
+	"github.com/docker/docker/api/types"
+)
+
+// Only recreation uses strict, bounded registry staging. Unrelated callers of
+// PullLatestImage retain their established signatures and fallback behavior.
+func (ds *dockerService) pullLatestRecreationImage(ctx context.Context, name string) (updated bool, err error) {
+	go PublishEventWrapper(ctx, common.EventTypeImagePullBegin, map[string]string{common.PropertyTypeImageName.Name: name})
+	defer func() {
+		common.PropertiesFromContext(ctx)[common.PropertyTypeImageUpdated.Name] = fmt.Sprint(updated)
+		if err != nil {
+			PublishEventWrapper(ctx, common.EventTypeImagePullError, map[string]string{common.PropertyTypeImageName.Name: name, common.PropertyTypeMessage.Name: "container recreation refused"})
+		}
+		PublishEventWrapper(ctx, common.EventTypeImagePullEnd, map[string]string{common.PropertyTypeImageName.Name: name})
+	}()
+	return stageRecreationImage(ctx, name, recreationImageDeps{image: docker.Image, compare: docker.CompareDigestContext, pull: docker.PullImageContext})
+}
+
+type recreationImageDeps struct {
+	image    func(context.Context, string) (*types.ImageInspect, error)
+	compare  func(context.Context, string, []string) (bool, error)
+	pull     func(context.Context, string, func(context.Context, io.ReadCloser) error) error
+}
+
+func stageRecreationImage(ctx context.Context, name string, deps recreationImageDeps) (bool, error) {
+	if ctx.Err() != nil || strings.HasPrefix(name, "sha256:") {
+		return false, errSyncthingPolicy
+	}
+	inspect := func() (*types.ImageInspect, error) {
+		readCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+		defer cancel()
+		image, err := deps.image(readCtx, name)
+		if err != nil || readCtx.Err() != nil || image == nil || image.ID == "" {
+			return nil, errSyncthingPolicy
+		}
+		return image, nil
+	}
+	before, err := inspect()
+	if err != nil {
+		return false, errSyncthingPolicy
+	}
+	match, err := deps.compare(ctx, name, before.RepoDigests)
+	if err != nil || ctx.Err() != nil {
+		return false, errSyncthingPolicy
+	}
+	if match {
+		return false, nil
+	}
+	if err := deps.pull(ctx, name, consumeRecreationPull); err != nil || ctx.Err() != nil {
+		return false, errSyncthingPolicy
+	}
+	after, err := inspect()
+	if err != nil || ctx.Err() != nil {
+		return false, errSyncthingPolicy
+	}
+	return before.ID != after.ID, nil
+}
