+package v1
+
+import (
+	"context"
+	"net/http"
+	"time"
+
+	"github.com/IceWhaleTech/CasaOS-AppManagement/codegen/message_bus"
+	"github.com/IceWhaleTech/CasaOS-AppManagement/model"
+	"github.com/IceWhaleTech/CasaOS-AppManagement/service"
+	modelCommon "github.com/IceWhaleTech/CasaOS-Common/model"
+	"github.com/IceWhaleTech/CasaOS-Common/utils/common_err"
+	"github.com/docker/docker/api/types"
+	"github.com/labstack/echo/v4"
+)
+
+// Private explicit dependencies, never a global hook or production override.
+// Public routes bind real inspection, fixed policy and existing writer/session paths.
+type legacyDependencies struct {
+	inspect func(context.Context, string) (*types.ContainerJSON, error)
+	check func(context.Context, string, *types.ContainerJSON, *model.CustomizationPostData) error
+	stop func(string) error
+	rename func(string, string) error
+	create func(model.CustomizationPostData, string) (string, error)
+	start func(string) error
+	remove func(string, bool) error
+	schedule func(func())
+	event func(context.Context, message_bus.EventType, map[string]string)
+	uninstall func(context.Context, *types.ContainerJSON, bool) error
+	terminal func(echo.Context, string) error
+}
+
+func productionLegacyDependencies() legacyDependencies {
+	docker := service.MyService.Docker()
+	return legacyDependencies{
+		inspect: docker.DescribeContainer, check: service.CheckLegacyContainerMutation,
+		stop: docker.StopContainer, rename: docker.RenameContainer, create: docker.CreateContainer,
+		start: docker.StartContainer, remove: docker.RemoveContainer,
+		schedule: func(work func()) { go work() },
+		event: func(ctx context.Context, event message_bus.EventType, properties map[string]string) { go service.PublishEventWrapper(ctx, event, properties) },
+		uninstall: uninstall, terminal: legacyTerminalSession,
+	}
+}
+
+func legacyRefusal(ctx echo.Context) error {
+	return ctx.JSON(http.StatusForbidden, modelCommon.Result{Success: common_err.SERVICE_ERROR, Message: "Syncthing manager policy refused"})
+}
+
+func legacyInspect(ctx echo.Context, operation string, d legacyDependencies) (*types.ContainerJSON, error) {
+	bounded, cancel := context.WithTimeout(ctx.Request().Context(), 3*time.Second)
+	defer cancel()
+	if ctx.Param("id") == "" { return nil, echo.ErrForbidden }
+	container, err := d.inspect(bounded, ctx.Param("id"))
+	if err != nil || bounded.Err() != nil { return nil, echo.ErrForbidden }
+	if d.check(bounded, operation, container, nil) != nil { return nil, echo.ErrForbidden }
+	return container, nil
+}
+
+func legacyUpdate(ctx echo.Context, d legacyDependencies) error {
+	container, err := legacyInspect(ctx, "legacy-update", d)
+	if err != nil { return legacyRefusal(ctx) }
+	m := model.CustomizationPostData{}
+	if err := ctx.Bind(&m); err != nil {
+		return ctx.JSON(http.StatusBadRequest, modelCommon.Result{Success: common_err.INVALID_PARAMS, Message: err.Error()})
+	}
+	if d.check(ctx.Request().Context(), "legacy-update", container, &m) != nil { return legacyRefusal(ctx) }
+	return legacyUpdateAdmitted(ctx, container.ID, m, d)
+}
+
+func legacyUninstall(ctx echo.Context, d legacyDependencies) error {
+	container, err := legacyInspect(ctx, "legacy-uninstall", d)
+	if err != nil { return legacyRefusal(ctx) }
+	return legacyUninstallAdmitted(ctx, container, d)
+}
+
+func legacyArchive(ctx echo.Context, d legacyDependencies) error {
+	container, err := legacyInspect(ctx, "legacy-archive", d)
+	if err != nil { return legacyRefusal(ctx) }
+	if err := d.stop(container.ID); err != nil {
+		return ctx.JSON(http.StatusInternalServerError, modelCommon.Result{Success: common_err.SERVICE_ERROR, Message: err.Error()})
+	}
+	if err := d.rename(container.Name+"_old", container.ID); err != nil {
+		return ctx.JSON(http.StatusInternalServerError, modelCommon.Result{Success: common_err.SERVICE_ERROR, Message: err.Error()})
+	}
+	return ctx.JSON(http.StatusOK, modelCommon.Result{Success: common_err.SUCCESS, Message: common_err.GetMsg(common_err.SUCCESS)})
+}
+
+func legacyTerminal(ctx echo.Context, d legacyDependencies) error {
+	container, err := legacyInspect(ctx, "legacy-terminal", d)
+	if err != nil { return legacyRefusal(ctx) }
+	return d.terminal(ctx, container.ID)
+}
