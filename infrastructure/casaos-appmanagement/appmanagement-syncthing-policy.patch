+func TestSyncthingRecreateStagingSuccessAndFailure(t *testing.T) {
+	for _, mode := range []string{"match", "updated", "same", "compare-failure", "pull-failure", "nil-image"} {
+		t.Run(mode, func(t *testing.T) {
+			calls, pulls := 0, 0
+			updated, err := stageRecreationImage(context.Background(), "ordinary:latest", recreationImageDeps{
+				image: func(context.Context, string) (*types.ImageInspect, error) {
+					calls++
+					if mode == "nil-image" {
+						return nil, nil
+					}
+					id := "ordinary"
+					if mode == "updated" && calls == 2 {
+						id = "updated"
+					}
+					return &types.ImageInspect{ID: id}, nil
+				},
+				compare: func(context.Context, string, []string) (bool, error) {
+					if mode == "compare-failure" {
+						return false, errors.New("SECRET-SENTINEL")
+					}
+					return mode == "match", nil
+				},
+				pull: func(context.Context, string, func(context.Context, io.ReadCloser) error) error {
+					pulls++
+					if mode == "pull-failure" {
+						return errors.New("SECRET-SENTINEL")
+					}
+					return nil
+				},
+			})
+			failure := strings.Contains(mode, "failure") || mode == "nil-image"
+			if (err != nil) != failure || updated != (mode == "updated") {
