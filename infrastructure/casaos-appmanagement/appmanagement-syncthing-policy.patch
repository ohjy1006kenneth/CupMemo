+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if mode == "deadline" { ctx, cancel = context.WithTimeout(ctx, 40*time.Millisecond); defer cancel() }
+			payload := `{"status":"Pulling fs layer","id":"ordinary"}`+"\n"+`{"aux":{"ID":"ordinary"}}`+"\n"
+			switch mode {
+			case "daemon-error": payload = `{"errorDetail":{"message":"PRIVATE-SENTINEL"},"error":"PRIVATE-SENTINEL"}`
+			case "error-only": payload = `{"error":"PRIVATE-SENTINEL"}`
+			case "progress-error": payload += `{"errorDetail":{"message":"PRIVATE-SENTINEL"}}`
+			case "malformed": payload = "!PRIVATE-SENTINEL"
+			case "truncated": payload = `{"status":"PRIVATE-SENTINEL`
