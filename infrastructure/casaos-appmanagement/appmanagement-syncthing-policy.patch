+import { posix } from 'node:path';
+import { pathToFileURL } from 'node:url';
+
+const operations = new Set([
+  'update',
+  'apply',
+  'pull-and-apply',
+  'pull',
+  'install',
+  'pull-and-install',
+  'uninstall',
+  'up',
+  'create',
+  'prepare-directory',
+]);
+const root = '/var/lib/casaos/apps/local-syncthing';
+const limit = 65536;
+const refusal = 'Syncthing manager policy refused\n';
+function exact(object, keys) {
+  return (
+    object !== null &&
+    typeof object === 'object' &&
+    !Array.isArray(object) &&
+    Object.keys(object).length === keys.length &&
+    keys.every((k) => Object.hasOwn(object, k))
+  );
+}
+function name(value) {
+  return (
+    typeof value === 'string' && value.length <= 255 && /^[a-zA-Z0-9][a-zA-Z0-9_.-]*$/.test(value)
+  );
+}
+function path(value) {
+  return (
+    typeof value === 'string' &&
+    value.length <= 4096 &&
+    value.startsWith('/') &&
+    /^[\x20-\x7e]+$/.test(value) &&
+    !value.includes('\\') &&
+    posix.normalize(value) === value &&
+    (value === '/' || !value.endsWith('/'))
+  );
+}
+function list(values, validate) {
+  return (
+    Array.isArray(values) &&
+    values.length <= 128 &&
+    new Set(values).size === values.length &&
+    values.every(validate)
+  );
+}
+function identity(value) {
+  return (
+    exact(value, ['name', 'workingDir', 'composeFiles', 'serviceNames']) &&
+    name(value.name) &&
+    (value.workingDir === '' || path(value.workingDir)) &&
+    list(value.composeFiles, path) &&
+    list(value.serviceNames, name)
+  );
+}
+function protectedIdentity(value) {
+  const protectedPath = (p) => p.toLowerCase() === root || p.toLowerCase().startsWith(root + '/');
+  return (
+    value.name.toLowerCase() === 'local-syncthing' ||
+    protectedPath(value.workingDir) ||
+    value.composeFiles.some(protectedPath) ||
+    value.serviceNames.some((s) => s.toLowerCase() === 'big-bear-syncthing')
+  );
+}
+export function allowed(request) {
+  return (
+    exact(request, ['version', 'operation', 'current', 'candidate']) &&
+    request.version === 1 &&
+    operations.has(request.operation) &&
+    identity(request.current) &&
+    (request.candidate === null || identity(request.candidate)) &&
+    !protectedIdentity(request.current) &&
+    (request.candidate === null || !protectedIdentity(request.candidate))
+  );
+}
+
+// JSON.parse discards duplicate keys. Parse the bounded protocol with explicit key sets instead.
+export function parseRequest(text) {
+  if (typeof text !== 'string' || Buffer.byteLength(text) > limit) throw new Error('invalid');
+  let i = 0;
+  const ws = () => {
+    while (/[\x20\t\r\n]/.test(text[i] ?? '\0')) i++;
+  };
+  function string() {
+    const start = i++;
+    while (i < text.length) {
+      const ch = text[i++];
+      if (ch === '\\') {
+        i++;
+        continue;
+      }
+      if (ch === '"') return JSON.parse(text.slice(start, i));
+    }
+    throw new Error('invalid');
+  }
+  function value(depth) {
+    if (depth > 8) throw new Error('invalid');
+    ws();
+    if (text[i] === '"') return string();
+    if (text[i] === '{') {
+      i++;
+      ws();
+      const result = Object.create(null);
+      if (text[i] === '}') {
+        i++;
+        return result;
+      }
+      while (true) {
+        ws();
+        if (text[i] !== '"') throw new Error('invalid');
+        const key = string();
+        if (Object.hasOwn(result, key)) throw new Error('invalid');
+        ws();
+        if (text[i++] !== ':') throw new Error('invalid');
+        result[key] = value(depth + 1);
+        ws();
+        if (text[i] === '}') {
+          i++;
+          return result;
+        }
+        if (text[i++] !== ',') throw new Error('invalid');
+      }
+    }
+    if (text[i] === '[') {
+      i++;
+      ws();
+      const result = [];
+      if (text[i] === ']') {
+        i++;
+        return result;
+      }
+      while (true) {
+        result.push(value(depth + 1));
+        ws();
+        if (text[i] === ']') {
+          i++;
+          return result;
+        }
+        if (text[i++] !== ',') throw new Error('invalid');
+      }
+    }
+    const match = /^(?:null|true|false|-?(?:0|[1-9]\d*)(?:\.\d+)?(?:[eE][+-]?\d+)?)/.exec(
+      text.slice(i),
+    );
+    if (!match) throw new Error('invalid');
+    i += match[0].length;
+    return JSON.parse(match[0]);
+  }
+  const result = value(0);
+  ws();
+  if (i !== text.length) throw new Error('invalid');
+  return result;
+}
+function main() {
+  if (process.argv.length !== 3 || process.argv[2] !== '--check') {
+    process.stderr.write(refusal);
+    process.exitCode = 2;
+    return;
+  }
+  let chunks = [],
+    size = 0,
+    finished = false;
+  const finish = (ok) => {
+    if (finished) return;
+    finished = true;
+    clearTimeout(timer);
+    chunks = [];
+    process.stdin.destroy();
+    if (ok) process.stdout.write('{"version":1,"allowed":true}\n');
+    else process.stderr.write(refusal);
+    process.exitCode = ok ? 0 : 1;
+  };
+  const timer = setTimeout(() => finish(false), 1500);
+  process.stdin.on('data', (chunk) => {
+    size += chunk.length;
+    if (size > limit) finish(false);
+    else chunks.push(chunk);
+  });
+  process.stdin.on('error', () => finish(false));
+  process.stdin.on('end', () => {
+    if (finished) return;
+    try {
+      finish(
+        allowed(
+          parseRequest(
+            new TextDecoder('utf-8', { fatal: true, ignoreBOM: true }).decode(
+              Buffer.concat(chunks),
+            ),
+          ),
+        ),
+      );
+    } catch {
+      finish(false);
+    }
+  });
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) main();
