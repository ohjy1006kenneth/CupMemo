+package docker
+
+import (
+	"context"
+	"errors"
+	"io"
+	"sync"
+	"time"
+
+	"github.com/docker/docker/api/types"
+	"github.com/docker/docker/client"
+)
+
+var errImagePullContext = errors.New("container recreation refused")
+
+type recreationPullClient interface {
+	ImagePull(context.Context, string, types.ImagePullOptions) (io.ReadCloser, error)
+	Close() error
+}
+
+// PullImageContext owns the real Docker client/body and returns consumer errors.
+// Legacy PullImage and its unrelated callers retain their existing behavior.
+func PullImageContext(ctx context.Context, imageName string, consume func(context.Context, io.ReadCloser) error) error {
+	return pullImageContext(ctx, imageName, consume, func() (recreationPullClient, error) {
+		return client.NewClientWithOpts(client.FromEnv, client.WithAPIVersionNegotiation())
+	}, getPullOptionsContext)
+}
+
+func pullImageContext(ctx context.Context, name string, consume func(context.Context, io.ReadCloser) error, newClient func() (recreationPullClient, error), options func(context.Context, string) (types.ImagePullOptions, error)) error {
+	if ctx.Err() != nil || consume == nil {
+		return errImagePullContext
+	}
+	ctx, cancel := context.WithTimeout(ctx, 10*time.Minute)
+	defer cancel()
+	cli, err := newClient()
+	if err != nil || cli == nil {
+		return errImagePullContext
+	}
+	defer cli.Close()
+	opts, err := options(ctx, name)
+	if err != nil || ctx.Err() != nil {
+		return errImagePullContext
+	}
+	// Bound API negotiation/headers without limiting a healthy entire download
+	// to 3s. Join any timer callback before inspecting the resulting context.
+	headerDone := make(chan struct{})
+	timer := time.AfterFunc(3*time.Second, func() { cancel(); close(headerDone) })
+	out, err := cli.ImagePull(ctx, name, opts)
+	if !timer.Stop() {
+		<-headerDone
+	}
+	if out == nil {
+		return errImagePullContext
+	}
+	body := &recreationPullBody{ReadCloser: out, cancel: cancel}
+	defer body.Close()
+	if err != nil || ctx.Err() != nil {
+		return errImagePullContext
+	}
+	// Cancellation closes the ACTUAL transport body to unblock Read. Always
+	// stop/join the watcher; never abandon an old synchronous consumer.
+	stop, joined := make(chan struct{}), make(chan struct{})
+	go func() {
+		defer close(joined)
+		select {
+		case <-ctx.Done():
+			body.Close()
+		case <-stop:
+		}
+	}()
+	defer func() { close(stop); <-joined }()
+	if err := consume(ctx, body); err != nil || ctx.Err() != nil {
+		return errImagePullContext
+	}
+	return nil
+}
+
+type recreationPullBody struct {
+	io.ReadCloser
+	cancel context.CancelFunc
+	once sync.Once
+}
+
+func (b *recreationPullBody) Close() error {
+	b.once.Do(func() { _ = b.ReadCloser.Close() })
+	return nil
+}
+
+func (b *recreationPullBody) Read(p []byte) (int, error) {
+	done := make(chan struct{})
+	timer := time.AfterFunc(3*time.Second, func() {
+		b.cancel()
+		b.Close()
+		close(done)
+	})
+	n, err := b.ReadCloser.Read(p)
+	if !timer.Stop() {
+		<-done
+		return n, errImagePullContext
+	}
+	return n, err
+}
