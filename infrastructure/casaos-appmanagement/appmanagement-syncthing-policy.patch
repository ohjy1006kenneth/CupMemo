 // ContentDigestHeader is the key for the key-value pair containing the digest header
 const ContentDigestHeader = "Docker-Content-Digest"
+
+// CompareDigestContext is the bounded registry path used by recreation. Legacy
+// callers retain their existing signatures and behavior.
+func CompareDigestContext(ctx context.Context, imageName string, repoDigests []string) (bool, error) {
+	transport := http.DefaultTransport.(*http.Transport).Clone()
+	transport.DisableKeepAlives = true
+	transport.ResponseHeaderTimeout = 3 * time.Second
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 3 * time.Second}
+	return compareDigestContext(ctx, imageName, repoDigests, client, func(name string) (types.ImagePullOptions, error) { return getPullOptionsContext(ctx, name) })
+}
+
+func compareDigestContext(ctx context.Context, imageName string, repoDigests []string, client *http.Client, options func(string) (types.ImagePullOptions, error)) (bool, error) {
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	opts, err := options(imageName)
+	if err != nil {
+		return false, err
+	}
+	challenge, err := getChallengeContext(ctx, client, imageName)
+	if err != nil {
+		return false, err
+	}
+	token, err := getTokenContext(ctx, client, challenge, TransformAuth(opts.RegistryAuth), imageName)
+	if err != nil {
+		return false, err
+	}
+	address, err := BuildManifestURL(imageName)
+	if err != nil {
+		return false, err
+	}
+	res, cancel, err := registryRequest(ctx, client, http.MethodHead, address, token)
+	if err != nil {
+		return false, err
+	}
+	defer cancel()
+	defer res.Body.Close()
+	if err := ctx.Err(); err != nil {
+		return false, err
+	}
+	if res.StatusCode != http.StatusOK {
+		return false, errors.New("registry digest refused")
+	}
+	digest := res.Header.Get(ContentDigestHeader)
+	if digest == "" {
+		return false, errors.New("missing registry digest")
+	}
+	for _, local := range repoDigests {
+		parts := strings.SplitN(local, "@", 2)
+		if len(parts) == 2 && parts[1] == digest {
+			return true, nil
+		}
+	}
+	return false, ctx.Err()
+}
 
