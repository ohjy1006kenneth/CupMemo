+package docker
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+	"time"
+
+	"github.com/docker/cli/cli/config/configfile"
+	"github.com/docker/cli/cli/config/credentials"
+	clitypes "github.com/docker/cli/cli/config/types"
+	"github.com/docker/docker/api/types"
+)
+
+// GetPullOptions transitively invokes native credential helpers without a
+// context. Recreation alone uses this bounded equivalent; legacy APIs are intact.
+func getPullOptionsContext(ctx context.Context, name string) (types.ImagePullOptions, error) {
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	if ctx.Err() != nil { return types.ImagePullOptions{}, errImagePullContext }
+	auth, err := EncodedEnvAuth(name)
+	if err != nil {
+		server, err := ParseServerAddress(name)
+		if err != nil { return types.ImagePullOptions{}, errImagePullContext }
+		dir := os.Getenv("DOCKER_CONFIG")
+		if dir == "" { dir = "/" }
+		path := filepath.Join(dir, "config.json")
+		cfg := configfile.New(path)
+		// Nonblocking open plus descriptor validation refuses special files even
+		// if replaced between lookup/open. Never read unbounded host config.
+		f, openErr := os.OpenFile(path, os.O_RDONLY|syscall.O_NONBLOCK, 0)
+		if openErr != nil && !os.IsNotExist(openErr) { return types.ImagePullOptions{}, errImagePullContext }
+		if openErr == nil {
+			defer f.Close()
+			info, err := f.Stat()
+			if err != nil || !info.Mode().IsRegular() || info.Size() > 1024*1024 { return types.ImagePullOptions{}, errImagePullContext }
+			data, err := io.ReadAll(io.LimitReader(f, 1024*1024+1))
+			if err != nil || len(data) > 1024*1024 || cfg.LoadFromReader(bytes.NewReader(data)) != nil { return types.ImagePullOptions{}, errImagePullContext }
+		}
+		var entry clitypes.AuthConfig
+		if cfg.CredentialsStore == "" {
+			entry, err = credentials.NewFileStore(cfg).Get(server)
+		} else {
+			entry, err = recreationCredential(ctx, cfg.CredentialsStore, server)
+		}
+		if err != nil || ctx.Err() != nil { return types.ImagePullOptions{}, errImagePullContext }
+		auth = ""
+		if entry != (clitypes.AuthConfig{}) {
+			auth, err = EncodeAuth(entry)
+			if err != nil { return types.ImagePullOptions{}, errImagePullContext }
+		}
+	}
+	if ctx.Err() != nil { return types.ImagePullOptions{}, errImagePullContext }
+	return types.ImagePullOptions{RegistryAuth:auth, PrivilegeFunc:func() (string,error) { return "",nil }}, nil
+}
+
+func recreationCredential(ctx context.Context, helper, server string) (clitypes.AuthConfig, error) {
+	if len(helper) == 0 || len(helper) > 128 || strings.ContainsAny(server, "\r\n") { return clitypes.AuthConfig{}, errImagePullContext }
+	for _, c := range helper {
+		if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.') { return clitypes.AuthConfig{}, errImagePullContext }
+	}
+	cmd := exec.CommandContext(ctx, "docker-credential-"+helper, "get")
+	cmd.Stdin = strings.NewReader(server+"\n")
+	cmd.SysProcAttr = &syscall.SysProcAttr{Setpgid:true}
+	cmd.Cancel = func() error { return syscall.Kill(-cmd.Process.Pid, syscall.SIGKILL) }
+	cmd.WaitDelay = 250*time.Millisecond
+	out := &recreationCredentialOutput{}
+	cmd.Stdout = out
+	cmd.Stderr = io.Discard
+	if cmd.Run() != nil || ctx.Err() != nil || out.overflow { return clitypes.AuthConfig{}, errImagePullContext }
+	var response struct { Username string; Secret string }
+	if json.Unmarshal(out.Bytes(), &response) != nil || response.Username == "" || response.Secret == "" { return clitypes.AuthConfig{}, errImagePullContext }
+	if response.Username == "<token>" { return clitypes.AuthConfig{IdentityToken:response.Secret, ServerAddress:server},nil }
+	return clitypes.AuthConfig{Username:response.Username, Password:response.Secret, ServerAddress:server},nil
+}
+
+type recreationCredentialOutput struct { buffer bytes.Buffer; overflow bool }
+func (b *recreationCredentialOutput) Bytes() []byte { return b.buffer.Bytes() }
+func (b *recreationCredentialOutput) Write(p []byte) (int,error) {
+	if b.buffer.Len()+len(p) > 64*1024 { b.overflow = true; return 0,errImagePullContext }
+	return b.buffer.Write(p)
+}
