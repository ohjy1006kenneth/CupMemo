+func TestSyncthingPolicyReplacementOrdering(t *testing.T) {
+	ctx := context.Background()
+	a := ordinaryPolicyApp()
+	for _, mode := range []string{"ordinary", "current-denied", "candidate-denied", "parser-failure"} {
+		t.Run(mode, func(t *testing.T) {
