+package docker
+
+import (
+	"context"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestSyncthingRecreateCredentialContext(t *testing.T) {
+	for _, mode := range []string{"anonymous", "file", "helper", "timeout", "overflow", "malformed"} {
+		t.Run(mode, func(t *testing.T) {
+			root := t.TempDir()
+			t.Setenv("REPO_USER", "")
+			t.Setenv("REPO_PASS", "")
+			t.Setenv("DOCKER_CONFIG", root)
+			t.Setenv("PATH", root+":/usr/bin:/bin")
+			config := `{"auths":{"registry.test":{"auth":"dXNlcjpwYXNz"}}}`
+			if mode == "anonymous" { config = `{}` }
+			if mode != "anonymous" && mode != "file" {
+				config = `{"credsStore":"fixture"}`
+				script := "#!/bin/sh\nread server\nprintf '%s' '{\"Username\":\"user\",\"Secret\":\"pass\"}'\n"
+				if mode == "timeout" { script = "#!/bin/sh\n/bin/sleep 10\n" }
+				if mode == "overflow" { script = "#!/bin/sh\n/usr/bin/head -c 70000 /dev/zero\n" }
+				if mode == "malformed" { script = "#!/bin/sh\nprintf 'PRIVATE-SENTINEL'\n" }
+				if err := os.WriteFile(filepath.Join(root, "docker-credential-fixture"), []byte(script), 0700); err != nil { t.Fatal(err) }
+			}
+			if err := os.WriteFile(filepath.Join(root, "config.json"), []byte(config), 0600); err != nil { t.Fatal(err) }
+			ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+			defer cancel()
+			started := time.Now()
+			opts, err := getPullOptionsContext(ctx, "registry.test/ordinary:latest")
+			failure := mode == "timeout" || mode == "overflow" || mode == "malformed"
+			if (err != nil) != failure || time.Since(started) > time.Second { t.Fatal("unbounded or wrong credential outcome", err) }
+			if err != nil && strings.Contains(err.Error(), "PRIVATE") { t.Fatal("credential error leak") }
+			if !failure && (opts.RegistryAuth == "") != (mode == "anonymous") { t.Fatal("credential behavior lost") }
+		})
+	}
+}
