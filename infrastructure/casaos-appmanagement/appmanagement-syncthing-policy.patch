+package service
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+
+	"github.com/docker/docker/pkg/jsonmessage"
+)
+
+// consumeRecreationPull treats the daemon stream as a strict success boundary.
+// Frame before decoding so encoding/json cannot allocate an unbounded message or
+// hide oversized frames in decoder read-ahead. Docker emits JSON objects; permit
+// arbitrary whitespace and adjacent objects, including clean EOF without newline.
+// Never log daemon status/error text or run the legacy best-effort progress loop.
+func consumeRecreationPull(ctx context.Context, out io.ReadCloser) error {
+	const messageLimit = 1024*1024
+	const streamLimit = 64*1024*1024
+	buffer := make([]byte, 32*1024)
+	frame := make([]byte, 0, 4096)
+	total, messages, depth := 0, 0, 0
+	quoted, escaped := false, false
+	for {
+		if ctx.Err() != nil { return errSyncthingPolicy }
+		n, readErr := out.Read(buffer)
+		total += n
+		if total > streamLimit || (n == 0 && readErr == nil) { return errSyncthingPolicy }
+		for _, b := range buffer[:n] {
+			if len(frame) == 0 {
+				if b == ' ' || b == '\n' || b == '\r' || b == '\t' { continue }
+				if b != '{' { return errSyncthingPolicy }
+			}
+			if len(frame) >= messageLimit { return errSyncthingPolicy }
+			frame = append(frame, b)
+			if quoted {
+				if escaped { escaped = false } else if b == '\\' { escaped = true } else if b == '"' { quoted = false }
+			} else {
+				switch b {
+				case '"': quoted = true
+				case '{', '[': depth++
+				case '}', ']': depth--
+				}
+			}
+			if depth == 0 {
+				var message jsonmessage.JSONMessage
+				if json.Unmarshal(frame, &message) != nil || message.Error != nil || message.ErrorMessage != "" || ctx.Err() != nil { return errSyncthingPolicy }
+				messages++
+				frame = frame[:0]
+			}
+		}
+		if readErr != nil {
+			if readErr != io.EOF || len(frame) != 0 || messages == 0 || ctx.Err() != nil { return errSyncthingPolicy }
+			return nil
+		}
+	}
+}
