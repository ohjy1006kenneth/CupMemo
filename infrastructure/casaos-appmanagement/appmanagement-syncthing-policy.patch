+	if err = os.MkdirAll(filepath.Dir(syncthingPolicyPath), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(syncthingPolicyPath, b, 0644); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Remove(syncthingPolicyPath) })
