+)
+
+const resolvedLegacyID = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
+
+func routeLegacyFixture(t *testing.T) {
+	t.Helper()
+	if os.Geteuid() != 0 { t.Fatal("disposable root required") }
+	if _, err := os.Stat("/.dockerenv"); err != nil { t.Fatal("disposable container required") }
+	filename := "/usr/local/lib/cupmemo/syncthing-manager-policy.mjs"
+	data, err := os.ReadFile("../../service/testdata/syncthing-manager-policy.mjs"); if err != nil { t.Fatal(err) }
+	if err := os.MkdirAll(filepath.Dir(filename), 0755); err != nil { t.Fatal(err) }
+	if err := os.WriteFile(filename, data, 0644); err != nil { t.Fatal(err) }
+	t.Cleanup(func() { os.Remove(filename) })
+}
+
+func routeLegacyContainer() *types.ContainerJSON {
+	return &types.ContainerJSON{ContainerJSONBase: &types.ContainerJSONBase{ID: resolvedLegacyID, Name: "/ordinary"}, Config: &container.Config{Labels: map[string]string{}}}
+}
+
+func routeLegacyDependencies(t *testing.T, c *types.ContainerJSON, calls *[]string) legacyDependencies {
+	t.Helper()
+	add := func(s string) { *calls = append(*calls, s) }
+	return legacyDependencies{
+		inspect: func(ctx context.Context, selector string) (*types.ContainerJSON, error) {
+			if selector != "request-alias" { t.Fatal("unexpected selector") }
+			deadline, ok := ctx.Deadline(); if !ok || time.Until(deadline) > 3*time.Second { t.Fatal("unbounded inspect") }
+			add("inspect"); return c, nil
+		},
+		check: func(ctx context.Context, op string, c *types.ContainerJSON, m *model.CustomizationPostData) error { add("check"); return service.CheckLegacyContainerMutation(ctx, op, c, m) },
+		stop: func(id string) error { add("stop:"+id); return nil },
+		rename: func(name, id string) error { add("rename:"+id); return nil },
+		create: func(m model.CustomizationPostData, id string) (string, error) { add("create:"+id); return "new-stable-id", nil },
+		start: func(id string) error { add("start:"+id); return nil },
+		remove: func(id string, force bool) error { add("remove:"+id); return nil },
+		schedule: func(work func()) { add("schedule"); work() },
+		event: func(context.Context, message_bus.EventType, map[string]string) { add("event") },
+		uninstall: func(ctx context.Context, c *types.ContainerJSON, remove bool) error { if !remove { t.Fatal("deletion flag lost") }; add("uninstall:"+c.ID); return nil },
+		terminal: func(ctx echo.Context, id string) error { add("terminal:"+id); return ctx.NoContent(200) },
+	}
+}
+
+func routeLegacyCall(t *testing.T, endpoint, body string, d legacyDependencies, cancelled bool) *httptest.ResponseRecorder {
+	t.Helper()
+	e := echo.New()
+	method := http.MethodPut
+	if endpoint == "uninstall" { method = http.MethodDelete }
+	if endpoint == "terminal" { method = http.MethodGet }
+	req := httptest.NewRequest(method, "/v1/container/request-alias", strings.NewReader(body))
+	req.Header.Set(echo.HeaderContentType, echo.MIMEApplicationJSON)
+	if cancelled { ctx, cancel := context.WithCancel(req.Context()); cancel(); req = req.WithContext(ctx) }
+	rec := httptest.NewRecorder(); ctx := e.NewContext(req, rec); ctx.SetParamNames("id"); ctx.SetParamValues("request-alias")
+	var err error
+	switch endpoint {
+	case "update": err = legacyUpdate(ctx, d)
+	case "uninstall": err = legacyUninstall(ctx, d)
+	case "archive": err = legacyArchive(ctx, d)
+	case "terminal": err = legacyTerminal(ctx, d)
+	default: t.Fatal("unknown test endpoint")
+	}
+	if err != nil { t.Fatal(err) }
+	return rec
+}
+
+func TestSyncthingLegacyHandlersDenyBeforeEffects(t *testing.T) {
+	routeLegacyFixture(t)
+	for _, endpoint := range []string{"update", "uninstall", "archive", "terminal"} {
+		for _, control := range []string{"protected-current", "inspection-error", "nil-inspect", "helper-error", "cancelled", "malformed-inspect"} {
+			t.Run(endpoint+"/"+control, func(t *testing.T) {
+				c := routeLegacyContainer(); calls := []string{}; d := routeLegacyDependencies(t, c, &calls)
+				switch control {
+				case "protected-current": c.Name = "/local-syncthing"
+				case "inspection-error": d.inspect = func(context.Context, string) (*types.ContainerJSON, error) { calls = append(calls, "inspect"); return nil, errors.New("SECRET-SENTINEL") }
+				case "nil-inspect": d.inspect = func(context.Context, string) (*types.ContainerJSON, error) { calls = append(calls, "inspect"); return nil, nil }
+				case "helper-error": d.check = func(context.Context, string, *types.ContainerJSON, *model.CustomizationPostData) error { calls = append(calls, "check"); return errors.New("SECRET-SENTINEL") }
+				case "malformed-inspect": c.Config = nil
+				}
+				// Invalid body proves protected update refuses BEFORE binding.
+				rec := routeLegacyCall(t, endpoint, "SECRET-SENTINEL-invalid-json", d, control == "cancelled")
+				if rec.Code != 403 || strings.Contains(rec.Body.String(), "SECRET-SENTINEL") || !strings.Contains(rec.Body.String(), "Syncthing manager policy refused") { t.Fatal(rec.Code, rec.Body.String()) }
+				for _, call := range calls { if call != "inspect" && call != "check" { t.Fatal("effect before admission", calls) } }
+			})
+		}
+	}
+}
+
+func TestSyncthingLegacyCandidateAndOrdinaryHandlers(t *testing.T) {
+	routeLegacyFixture(t)
