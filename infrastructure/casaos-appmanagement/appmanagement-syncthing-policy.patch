+			n := 0
+			d := syncthingDependencies{}
+			d.check = func(_ context.Context, op string, current, candidate *syncthingIdentity) error {
+				n++
+				calls = append(calls, "check")
+				if op != "apply" || current.Name != "ordinary" {
+					t.Fatal("projection")
+				}
+				if candidate != nil && (candidate.WorkingDir != a.WorkingDir || !reflect.DeepEqual(candidate.ComposeFiles, a.ComposeFiles)) {
+					t.Fatal("effective destination")
