+func policyFixture(t *testing.T) {
+	t.Helper()
+	// Fixed-path custody fixtures are permitted ONLY inside the disposable root container.
+	if os.Geteuid() != 0 {
+		t.Fatal("requires disposable root container")
+	}
+	if _, err := os.Stat("/.dockerenv"); err != nil {
+		t.Fatal("requires disposable container")
+	}
+	b, err := os.ReadFile("testdata/syncthing-manager-policy.mjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err = os.MkdirAll(filepath.Dir(syncthingPolicyPath), 0755); err != nil {
+		t.Fatal(err)
+	}
+	if err = os.WriteFile(syncthingPolicyPath, b, 0644); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { os.Remove(syncthingPolicyPath) })
+}
+func ordinaryPolicyApp() *ComposeApp {
+	return &ComposeApp{Name: "ordinary", WorkingDir: "/synthetic/ordinary", ComposeFiles: []string{"/synthetic/ordinary/docker-compose.yml"}, Services: []types.ServiceConfig{{Name: "ordinary"}}}
+}
+func requirePolicyRefusal(t *testing.T, err error) {
+	t.Helper()
+	if err != errSyncthingPolicy {
+		t.Fatalf("expected sanitized refusal, got %v", err)
+	}
+}
+
+func TestSyncthingPolicyProjection(t *testing.T) {
+	a := ordinaryPolicyApp()
+	i := projectSyncthingIdentity(a)
+	if i.Name != a.Name || i.WorkingDir != a.WorkingDir || !reflect.DeepEqual(i.ServiceNames, []string{"ordinary"}) {
+		t.Fatal(i)
+	}
+	i.ComposeFiles[0] = "changed"
+	if a.ComposeFiles[0] == "changed" {
+		t.Fatal("aliased compose paths")
+	}
+	if projectSyncthingIdentity(nil) != nil {
+		t.Fatal("nil projection")
+	}
+}
+
+func TestSyncthingPolicyRealNodeAndGuardedMethods(t *testing.T) {
+	policyFixture(t)
+	ctx := context.Background()
+	a := ordinaryPolicyApp()
+	// Poisoning the inherited Node environment must not enter the real fixed command.
+	t.Setenv("NODE_OPTIONS", "--import=/SECRET-SENTINEL-NOT-LOADED")
+	if err := a.CheckMutation(ctx, "create", nil); err != nil {
+		t.Fatal(err)
+	}
+	candidate := ordinaryPolicyApp()
+	candidate.Services[0].Name = "big-bear-syncthing"
+	requirePolicyRefusal(t, a.CheckMutation(ctx, "apply", candidate))
+	protected := ordinaryPolicyApp()
+	protected.Name = "local-syncthing"
+	protected.ComposeFiles = nil
+	s := NewComposeService()
+	methods := map[string]func() error{
+		"update":                              func() error { return protected.Update(ctx) },
+		"apply":                               func() error { return protected.Apply(ctx, []byte("SECRET-SENTINEL invalid YAML")) },
+		"pull-and-apply-empty":                func() error { return protected.PullAndApply(ctx, nil) },
+		"pull":                                func() error { return protected.Pull(ctx) },
+		"up":                                  func() error { return protected.Up(ctx, nil) },
+		"up-with-requirements":                func() error { return protected.UpWithCheckRequire(ctx, nil) },
+		"create":                              func() error { return protected.Create(ctx, api.CreateOptions{}, nil) },
+		"pull-install":                        func() error { return protected.PullAndInstall(ctx) },
+		"uninstall":                           func() error { return protected.Uninstall(ctx, true) },
+		"service-install":                     func() error { return s.Install(ctx, protected) },
+		"service-uninstall-before-scheduling": func() error { return s.Uninstall(ctx, protected, true) },
+		"prepare-before-mkdir":                func() error { _, err := s.PrepareWorkingDirectory("local-syncthing"); return err },
+	}
+	// Nil Docker dependencies and invalid YAML/empty ComposeFiles make any pre-admission
+	// parser/index/client/scheduling regression fail, rather than touching real services.
+	for name, f := range methods {
+		t.Run(name, func(t *testing.T) { requirePolicyRefusal(t, f()) })
+	}
+	prefix := ordinaryPolicyApp()
+	prefix.Name = "local-syncthing-extra"
+	prefix.WorkingDir = "/var/lib/casaos/apps/local-syncthing-extra"
+	if err := prefix.CheckMutation(ctx, "create", nil); err != nil {
+		t.Fatal(err)
+	}
+}
