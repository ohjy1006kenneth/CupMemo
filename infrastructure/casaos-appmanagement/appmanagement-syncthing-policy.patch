+				if cmd.Path != "/usr/bin/node" || !reflect.DeepEqual(cmd.Args, []string{"/usr/bin/node", syncthingPolicyPath, "--check"}) || !reflect.DeepEqual(cmd.Env, []string{"PATH=/usr/bin:/bin", "LANG=C.UTF-8"}) || cmd.WaitDelay != 250*time.Millisecond {
