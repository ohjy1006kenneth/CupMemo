+
+type pullTransport func(*http.Request) (*http.Response, error)
+func (f pullTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type pullProtocolBody struct {
+	io.Reader
+	block bool
+	cancel context.CancelFunc
+	cancelEOF bool
+	closed chan struct{}
+	count atomic.Int32
+	once sync.Once
+}
+func (b *pullProtocolBody) Read(p []byte) (int, error) {
+	if b.cancel != nil && !b.cancelEOF { b.cancel() }
+	if b.block { <-b.closed; return 0, errors.New("PRIVATE-SENTINEL") }
+	n, err := b.Reader.Read(p)
+	if b.cancelEOF && err == io.EOF { b.cancel() }
+	return n, err
+}
+func (b *pullProtocolBody) Close() error {
+	b.count.Add(1)
+	b.once.Do(func() { close(b.closed) })
+	return nil
+}
+
+type pullReadFailure struct{}
+func (pullReadFailure) Read([]byte) (int, error) { return 0, errors.New("PRIVATE-SENTINEL") }
+
+type pullRepeatFrame struct { frame string; position int }
+func (r *pullRepeatFrame) Read(p []byte) (int, error) {
+	for i := range p { p[i] = r.frame[r.position]; r.position = (r.position+1)%len(r.frame) }
+	return len(p), nil
+}
