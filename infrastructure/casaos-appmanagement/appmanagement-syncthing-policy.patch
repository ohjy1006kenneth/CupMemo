+)
+
+type recreateTransport func(*http.Request) (*http.Response, error)
+
+func (f recreateTransport) RoundTrip(r *http.Request) (*http.Response, error) { return f(r) }
+
+type recreateBody struct {
+	ctx    context.Context
+	closed bool
+	read   bool
+}
+
+func (b *recreateBody) Read([]byte) (int, error) {
+	b.read = true
+	<-b.ctx.Done()
+	return 0, b.ctx.Err()
+}
+func (b *recreateBody) Close() error { b.closed = true; return nil }
+
+func TestSyncthingRecreateRegistryCancellation(t *testing.T) {
+	for _, stage := range []string{"challenge-header", "token-header", "token-body", "digest-header"} {
+		for _, parentCancel := range []bool{false, true} {
+			t.Run(stage+map[bool]string{false: "-deadline", true: "-cancel"}[parentCancel], func(t *testing.T) {
+				ctx, cancel := context.WithTimeout(context.Background(), 40*time.Millisecond)
+				defer cancel()
+				var body *recreateBody
+				calls := 0
+				client := &http.Client{Transport: recreateTransport(func(r *http.Request) (*http.Response, error) {
+					calls++
+					if _, ok := r.Context().Deadline(); !ok {
+						t.Fatal("unbounded request")
+					}
+					which := map[int]string{1: "challenge-header", 2: "token-header", 3: "digest-header"}[calls]
+					if stage == which {
+						if parentCancel {
+							cancel()
+						}
+						<-r.Context().Done()
+						return nil, r.Context().Err()
+					}
+					res := &http.Response{StatusCode: 200, Header: make(http.Header), Body: io.NopCloser(strings.NewReader(""))}
+					res.Header.Set(ChallengeHeader, `Bearer realm="https://registry.test/token",service="registry.test"`)
+					if calls == 2 {
+						if stage == "token-body" {
+							body = &recreateBody{ctx: r.Context()}
+							res.Body = body
+							if parentCancel {
+								cancel()
+							}
+						} else {
+							res.Body = io.NopCloser(strings.NewReader(`{"token":"ordinary"}`))
+						}
+					}
+					return res, nil
+				})}
+				started := time.Now()
+				_, err := compareDigestContext(ctx, "registry.test/ordinary:latest", nil, client, func(string) (types.ImagePullOptions, error) { return types.ImagePullOptions{}, nil })
+				if err == nil || time.Since(started) > time.Second {
+					t.Fatal("unbounded or successful cancellation", err)
+				}
+				if !errors.Is(err, context.Canceled) && !errors.Is(err, context.DeadlineExceeded) {
+					t.Fatal(err)
+				}
+				if body != nil && (!body.closed || !body.read || body.ctx.Err() == nil) {
+					t.Fatal("body not canceled and closed")
+				}
+			})
+		}
+	}
+}
+
+func TestSyncthingRecreateRegistrySuccess(t *testing.T) {
+	for _, basic := range []bool{false, true} {
+		calls := 0
+		closed := 0
+		client := &http.Client{Transport: recreateTransport(func(r *http.Request) (*http.Response, error) {
+			calls++
+			res := &http.Response{StatusCode: 200, Header: make(http.Header), Body: &recreateTrackedBody{Reader: strings.NewReader(`{"token":"ordinary"}`), closed: &closed}}
+			if basic {
+				res.Header.Set(ChallengeHeader, "Basic realm=registry")
+			} else {
+				res.Header.Set(ChallengeHeader, `Bearer realm="https://registry.test/token",service="registry.test"`)
+			}
+			if r.Method == http.MethodHead {
+				if r.Header.Get("Authorization") == "" {
+					t.Fatal("missing token")
+				}
+				res.Header.Set(ContentDigestHeader, "sha256:ordinary")
+			}
+			return res, nil
+		})}
+		match, err := compareDigestContext(context.Background(), "registry.test/ordinary:latest", []string{"registry.test/ordinary@sha256:ordinary"}, client, func(string) (types.ImagePullOptions, error) {
+			return types.ImagePullOptions{RegistryAuth: "ordinary"}, nil
+		})
+		if err != nil || !match || closed != calls || calls != map[bool]int{false: 3, true: 2}[basic] {
+			t.Fatal(match, err, calls, closed)
+		}
+	}
+}
+
+type recreateTrackedBody struct {
+	*strings.Reader
+	closed *int
+}
+
+func (b *recreateTrackedBody) Close() error { *b.closed++; return nil }
+
+func TestSyncthingRecreateRegistryReadBound(t *testing.T) {
+	client := &http.Client{Transport: recreateTransport(func(r *http.Request) (*http.Response, error) {
+		<-r.Context().Done()
+		return nil, r.Context().Err()
+	})}
+	started := time.Now()
+	_, err := compareDigestContext(context.Background(), "registry.test/ordinary:latest", nil, client, func(string) (types.ImagePullOptions, error) { return types.ImagePullOptions{}, nil })
+	if !errors.Is(err, context.DeadlineExceeded) || time.Since(started) > 4*time.Second {
+		t.Fatal("missing actual 3s registry bound", err)
+	}
+}
+
+func TestSyncthingRecreateRegistryInvalidAndCompatibility(t *testing.T) {
+	for _, challenge := range []string{"bearer invalid", `bearer realm="%",service="registry.test"`, `bearer realm="http://registry.test/token",service="registry.test"`, "unknown", "basic"} {
+		client := &http.Client{Transport: recreateTransport(func(*http.Request) (*http.Response, error) {
+			t.Fatal("invalid challenge issued request")
+			return nil, nil
+		})}
+		if _, err := getTokenContext(context.Background(), client, challenge, "", "ordinary:latest"); err == nil {
+			t.Fatal("invalid challenge admitted")
+		}
+	}
+	if got, err := GetToken("basic", "ordinary", "ordinary"); err != nil || got != "Basic ordinary" {
+		t.Fatal("unrelated wrapper behavior changed")
+	}
+}
