+package docker
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"regexp"
+	"strings"
+
+	"github.com/docker/docker/api/types"
+	"github.com/docker/docker/api/types/container"
+	"github.com/docker/docker/api/types/network"
+	"github.com/docker/docker/client"
+	"github.com/docker/go-connections/nat"
+)
+
+var errClonePlan = errors.New("container clone preparation refused")
+var cloneImageID = regexp.MustCompile(`^sha256:[a-f0-9]{64}$`)
+var cloneContainerID = regexp.MustCompile(`^[a-f0-9]{64}$`)
+var cloneName = regexp.MustCompile(`^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,254}$`)
+
+// ContainerClonePlan owns its inspected snapshots. No mutable config is exported.
+type ContainerClonePlan struct {
+	id      string
+	name    string
+	config  *container.Config
+	host    *container.HostConfig
+	network *network.NetworkingConfig
+}
+
+func cloneSnapshot(input, output interface{}) error {
+	data, err := json.Marshal(input)
+	if err != nil || len(data) > 4*1024*1024 {
+		return errClonePlan
+	}
+	if json.Unmarshal(data, output) != nil {
+		return errClonePlan
+	}
+	return nil
+}
+
+func validCloneLabels(labels map[string]string) bool {
+	if len(labels) > 1024 {
+		return false
+	}
+	for key, value := range labels {
+		if key == "" || len(key) > 4096 || len(value) > 16384 || strings.ContainsAny(key+value, "\x00\r\n") {
+			return false
+		}
+	}
+	return true
+}
+
+// PrepareContainerClone performs no Docker effects and freezes the target image.
+func PrepareContainerClone(current *types.ContainerJSON, oldImage *types.ImageInspect, targetImage *types.ImageInspect) (*ContainerClonePlan, error) {
+	if current == nil || current.ContainerJSONBase == nil || current.Config == nil || current.HostConfig == nil || current.NetworkSettings == nil || oldImage == nil || targetImage == nil || oldImage.Config == nil || targetImage.Config == nil {
+		return nil, errClonePlan
+	}
+	if !cloneContainerID.MatchString(current.ID) || !strings.HasPrefix(current.Name, "/") || !cloneName.MatchString(strings.TrimPrefix(current.Name, "/")) || !cloneImageID.MatchString(current.Image) || current.Image != oldImage.ID || !cloneImageID.MatchString(targetImage.ID) || current.Config.Image == "" {
+		return nil, errClonePlan
+	}
+	for _, labels := range []map[string]string{current.Config.Labels, oldImage.Config.Labels, targetImage.Config.Labels} {
+		if !validCloneLabels(labels) {
+			return nil, errClonePlan
+		}
+	}
+	for _, link := range current.HostConfig.Links {
+		colon := strings.Index(link, ":")
+		slash := strings.LastIndex(link, "/")
+		if colon <= 0 || slash <= colon || slash == len(link)-1 {
+			return nil, errClonePlan
+		}
+	}
+	for key, endpoint := range current.NetworkSettings.Networks {
+		if key == "" || endpoint == nil {
+			return nil, errClonePlan
+		}
+	}
+	var c types.ContainerJSON
+	var old types.ImageInspect
+	var target types.ImageInspect
+	if cloneSnapshot(current, &c) != nil || cloneSnapshot(oldImage, &old) != nil || cloneSnapshot(targetImage, &target) != nil {
+		return nil, errClonePlan
+	}
+	if c.Config.ExposedPorts == nil {
+		c.Config.ExposedPorts = nat.PortSet{}
+	}
+	config := runtimeConfig(&c, &old)
+	if config.Labels == nil {
+		config.Labels = map[string]string{}
+	}
+	for key, value := range target.Config.Labels {
+		if _, present := config.Labels[key]; !present {
+			config.Labels[key] = value
+		}
+	}
+	config.Image = target.ID
+	return &ContainerClonePlan{id: c.ID, name: c.Name, config: config, host: hostConfig(&c), network: &network.NetworkingConfig{EndpointsConfig: c.NetworkSettings.Networks}}, nil
+}
+
+// EffectiveContainer returns only resolved identity, never Env or internal handles.
+func (p *ContainerClonePlan) EffectiveContainer() *types.ContainerJSON {
+	if p == nil || p.config == nil {
+		return nil
+	}
+	labels := map[string]string{}
+	for k, v := range p.config.Labels {
+		labels[k] = v
+	}
+	return &types.ContainerJSON{ContainerJSONBase: &types.ContainerJSONBase{ID: p.id, Name: p.name}, Config: &container.Config{Labels: labels}}
+}
+
+type clonePlanDeps struct {
+	create     func(context.Context, *container.Config, *container.HostConfig, *network.NetworkingConfig, string) (string, error)
+	disconnect func(context.Context, string, string) error
+	connect    func(context.Context, string, string, *network.EndpointSettings) error
+}
+
+func cloneContainerFromPlan(ctx context.Context, plan *ContainerClonePlan, newName string, deps clonePlanDeps) (string, error) {
+	if ctx.Err() != nil || plan == nil || plan.config == nil || plan.host == nil || plan.network == nil || !cloneContainerID.MatchString(plan.id) || !cloneImageID.MatchString(plan.config.Image) || !cloneName.MatchString(newName) || deps.create == nil {
+		return "", errClonePlan
+	}
+	var config container.Config
+	var host container.HostConfig
+	var net network.NetworkingConfig
+	if cloneSnapshot(plan.config, &config) != nil || cloneSnapshot(plan.host, &host) != nil || cloneSnapshot(plan.network, &net) != nil {
+		return "", errClonePlan
+	}
+	simple := simpleNetworkConfig(&net)
+	id, err := deps.create(ctx, &config, &host, simple, newName)
+	if err != nil {
+		return id, err
+	}
+	if !host.NetworkMode.IsHost() {
+		for key := range simple.EndpointsConfig {
+			if err := deps.disconnect(ctx, key, id); err != nil {
+				return id, err
+			}
+		}
+		for key, endpoint := range net.EndpointsConfig {
+			if err := deps.connect(ctx, key, id, endpoint); err != nil {
+				return id, err
+			}
+		}
+	}
+	return id, nil
+}
+
+// CloneContainerFromPlan never looks up a tag or recomputes runtimeConfig.
+func CloneContainerFromPlan(ctx context.Context, plan *ContainerClonePlan, newName string) (string, error) {
+	if ctx.Err() != nil || plan == nil || plan.config == nil || plan.host == nil || plan.network == nil {
+		return "", errClonePlan
+	}
+	cli, err := client.NewClientWithOpts(client.FromEnv, client.WithAPIVersionNegotiation())
+	if err != nil {
+		return "", err
+	}
+	defer cli.Close()
+	return cloneContainerFromPlan(ctx, plan, newName, clonePlanDeps{
+		create: func(ctx context.Context, c *container.Config, h *container.HostConfig, n *network.NetworkingConfig, name string) (string, error) {
+			r, err := cli.ContainerCreate(ctx, c, h, n, nil, name)
+			return r.ID, err
+		},
+		disconnect: func(ctx context.Context, net, id string) error { return cli.NetworkDisconnect(ctx, net, id, true) },
+		connect: func(ctx context.Context, net, id string, e *network.EndpointSettings) error {
+			return cli.NetworkConnect(ctx, net, id, e)
+		},
+	})
+}
