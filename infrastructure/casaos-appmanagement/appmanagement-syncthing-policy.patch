 // ChallengeHeader is the HTTP Header containing challenge instructions
 const ChallengeHeader = "WWW-Authenticate"
+
+// registryRequest bounds the complete request, including body consumption. The
+// caller must close the body BEFORE canceling this child context.
+func registryRequest(ctx context.Context, client *http.Client, method, address, token string) (*http.Response, context.CancelFunc, error) {
+	readCtx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	req, err := http.NewRequestWithContext(readCtx, method, address, nil)
+	if err != nil {
+		cancel()
+		return nil, nil, err
+	}
+	req.Header.Set("User-Agent", "CasaOS")
+	if token != "" {
+		addDefaultHeaders(&req.Header, token)
+	}
+	res, err := client.Do(req)
+	if err != nil {
+		cancel()
+		return nil, nil, err
+	}
+	return res, cancel, nil
+}
+
+func getChallengeContext(ctx context.Context, client *http.Client, imageName string) (string, error) {
+	if _, err := reference.ParseNormalizedNamed(imageName); err != nil {
+		return "", err
+	}
+	address, err := GetChallengeURL(imageName)
+	if err != nil {
+		return "", err
+	}
+	res, cancel, err := registryRequest(ctx, client, http.MethodGet, address.String(), "")
+	if err != nil {
+		return "", err
+	}
+	defer cancel()
+	defer res.Body.Close()
+	return strings.ToLower(res.Header.Get(ChallengeHeader)), nil
+}
+
+func getTokenContext(ctx context.Context, client *http.Client, challenge, registryAuth, imageName string) (string, error) {
+	if strings.HasPrefix(challenge, "basic") {
+		if registryAuth == "" {
+			return "", errors.New("missing registry credentials")
+		}
+		return "Basic " + registryAuth, nil
+	}
+	if !strings.HasPrefix(challenge, "bearer") {
+		return "", errors.New("unsupported registry challenge")
+	}
+	// Validate before the legacy parser, which assumes every pair contains '='.
+	for _, pair := range strings.Split(strings.TrimPrefix(challenge, "bearer"), ",") {
+		if len(strings.Split(pair, "=")) != 2 {
+			return "", errors.New("invalid registry challenge")
+		}
+		parts := strings.Split(pair, "=")
+		if strings.TrimSpace(parts[0]) == "realm" {
+			if _, err := url.Parse(strings.Trim(parts[1], "\"")); err != nil {
+				return "", err
+			}
+		}
+	}
+	if strings.Contains(imageName, ":") {
+		imageName = strings.Split(imageName, ":")[0]
+	}
+	address, err := GetAuthURL(challenge, imageName)
+	if err != nil {
+		return "", err
+	}
+	if address.Scheme != "https" || address.Host == "" {
+		return "", errors.New("invalid registry token URL")
+	}
+	token := ""
+	if registryAuth != "" {
+		token = "Basic " + registryAuth
+	}
+	res, cancel, err := registryRequest(ctx, client, http.MethodGet, address.String(), token)
+	if err != nil {
+		return "", err
+	}
+	defer cancel()
+	defer res.Body.Close()
+	if res.StatusCode != http.StatusOK {
+		return "", errors.New("registry token refused")
+	}
+	body, err := io.ReadAll(io.LimitReader(res.Body, 1024*1024+1))
+	if err != nil {
+		return "", err
+	}
+	if len(body) > 1024*1024 {
+		return "", errors.New("registry token response too large")
+	}
+	var response TokenResponse
+	if err := json.Unmarshal(body, &response); err != nil {
+		return "", err
+	}
+	if response.Token == "" {
+		return "", errors.New("missing registry token")
+	}
+	return "Bearer " + response.Token, nil
+}
 
