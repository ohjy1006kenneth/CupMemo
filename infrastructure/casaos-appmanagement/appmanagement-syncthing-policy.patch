+package docker
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net/http"
+	"strings"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/docker/docker/api/types"
+	"github.com/docker/docker/client"
+)
+
+type pullTestBody struct {
+	io.Reader
+	closed int
+	unblock chan struct{}
+	once sync.Once
+}
+
+func (b *pullTestBody) Read(p []byte) (int, error) {
+	if b.unblock != nil {
+		<-b.unblock
+		return 0, errors.New("PRIVATE-SENTINEL")
+	}
+	return b.Reader.Read(p)
+}
+func (b *pullTestBody) Close() error {
+	b.once.Do(func() {
+		b.closed++
+		if b.unblock != nil { close(b.unblock) }
+	})
+	return nil
+}
+
+func TestSyncthingRecreateStrictPullAdapter(t *testing.T) {
+	for _, mode := range []string{"success", "consumer", "nil-consumer", "setup", "auth", "http", "header-cancel", "header-deadline", "header-read-bound", "body-cancel", "body-deadline", "body-read-bound"} {
+		t.Run(mode, func(t *testing.T) {
+			ctx, cancel := context.WithCancel(context.Background())
+			defer cancel()
+			if strings.Contains(mode, "deadline") { ctx, cancel = context.WithTimeout(ctx, 40*time.Millisecond); defer cancel() }
+			body := &pullTestBody{Reader: strings.NewReader(`{"status":"ordinary"}`)}
+			if strings.HasPrefix(mode, "body-") { body.unblock = make(chan struct{}) }
+			requests, consumed := 0, 0
+			var requestCtx context.Context
+			factory := func() (recreationPullClient, error) {
+				if mode == "setup" { return nil, errors.New("PRIVATE-SENTINEL") }
+				return client.NewClientWithOpts(client.WithHost("http://docker.test"), client.WithVersion("1.41"), client.WithHTTPClient(&http.Client{Transport: recreateTransport(func(r *http.Request) (*http.Response, error) {
+					requests++
+					requestCtx = r.Context()
+					if !strings.HasSuffix(r.URL.Path, "/images/create") { t.Fatal("unexpected Docker API") }
+					if strings.HasPrefix(mode, "header-") {
+						if mode == "header-cancel" { cancel() }
+						<-r.Context().Done()
+						return nil, r.Context().Err()
+					}
+					if mode == "body-cancel" { cancel() }
+					status := 200
+					if mode == "http" { status = 500 }
+					return &http.Response{StatusCode: status, Header: make(http.Header), Body: body}, nil
+				})}))
+			}
+			options := func(context.Context, string) (types.ImagePullOptions, error) {
+				if mode == "auth" { return types.ImagePullOptions{}, errors.New("PRIVATE-SENTINEL") }
+				return types.ImagePullOptions{}, nil
+			}
+			consume := func(ctx context.Context, out io.ReadCloser) error {
+				consumed++
+				if mode == "consumer" { return errors.New("PRIVATE-SENTINEL") }
+				_, err := io.ReadAll(out)
+				return err
+			}
+			if mode == "nil-consumer" { consume = nil }
+			started := time.Now()
+			err := pullImageContext(ctx, "ordinary:latest", consume, factory, options)
+			if (err == nil) != (mode == "success") || (err != nil && err.Error() != "container recreation refused") { t.Fatal("unsanitized or unexpected result", err) }
+			bound := time.Second
+			if mode == "body-read-bound" || mode == "header-read-bound" { bound = 4*time.Second }
+			if time.Since(started) > bound { t.Fatal("unbounded adapter") }
+			if requests > 0 && !strings.HasPrefix(mode, "header-") && body.closed != 1 { t.Fatal("body not closed exactly once", body.closed) }
+			if requestCtx != nil && requestCtx.Err() == nil { t.Fatal("request still alive after return") }
+			if mode == "nil-consumer" && (requests != 0 || consumed != 0) { t.Fatal("nil consumer effects") }
+		})
+	}
+}
+
+func TestSyncthingRecreateLegacyPullSignature(t *testing.T) {
+	// Compile-time regression: no change to unrelated exported legacy callers.
+	var legacy func(context.Context, string, func(io.ReadCloser)) error = PullImage
+	var strict func(context.Context, string, func(context.Context, io.ReadCloser) error) error = PullImageContext
+	if legacy == nil || strict == nil { t.Fatal("missing API") }
+}
