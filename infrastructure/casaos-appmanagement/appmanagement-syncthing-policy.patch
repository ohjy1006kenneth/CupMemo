+	for _, p := range []*ContainerClonePlan{nil, {}, plan} {
+		if _, err := cloneContainerFromPlan(ctx, p, "temporary", deps); err == nil {
+			t.Fatal("cancelled/invalid admitted")
+		}
+	}
