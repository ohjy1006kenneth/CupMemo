+// CupMemo Samba writer boundary. No runtime policy/path overrides.
+package service
+
+import (
+	"bytes"
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"time"
+
+	model2 "github.com/IceWhaleTech/CasaOS/service/model"
+	"golang.org/x/sys/unix"
+)
+
+const sambaPolicyLimit = 1024 * 1024
+
+var errSambaPolicy = errors.New("SAMBA_POLICY_REFUSED")
+
+// Explicit instance dependencies, never mutable global test hooks.
+type sambaPolicyDeps struct {
+	read         func() (string, error)
+	checkAdapter func() error
+	run          func(context.Context, []byte) ([]byte, error)
+	write        func(string) error
+	reload       func() error
+	chmod        func(string, os.FileMode) error
+}
+
+func sambaProductionPolicy() sambaPolicyDeps {
+	return sambaPolicyDeps{sambaPolicyRead, sambaCheckAdapter, sambaAdapterRun, sambaWriteInclude, sambaReload, os.Chmod}
+}
+
+type sambaMutation struct {
+	Operation string `json:"operation"`
+	Name      string `json:"name"`
+	Path      string `json:"path"`
+}
+
+// Open each directory relative to the previous verified descriptor: no symlink
+// traversal, no writable ancestry, no environment-derived paths.
+func sambaSafeDirectory(path string) (int, error) {
+	fd, err := unix.Open("/", unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return -1, errSambaPolicy
+	}
+	check := func(fd int) bool {
+		var st unix.Stat_t
+		return unix.Fstat(fd, &st) == nil && st.Uid == 0 && st.Mode&unix.S_IFMT == unix.S_IFDIR && st.Mode&0022 == 0
+	}
+	if !check(fd) {
+		unix.Close(fd)
+		return -1, errSambaPolicy
+	}
+	for _, component := range strings.Split(strings.TrimPrefix(path, "/"), "/") {
+		if component == "" || component == "." || component == ".." {
+			unix.Close(fd)
+			return -1, errSambaPolicy
+		}
+		next, e := unix.Openat(fd, component, unix.O_RDONLY|unix.O_DIRECTORY|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+		unix.Close(fd)
+		if e != nil {
+			return -1, errSambaPolicy
+		}
+		fd = next
+		if !check(fd) {
+			unix.Close(fd)
+			return -1, errSambaPolicy
+		}
+	}
+	return fd, nil
+}
+
+func sambaSafeFile(path string, private bool) (*os.File, unix.Stat_t, error) {
+	var st unix.Stat_t
+	dir, err := sambaSafeDirectory(filepath.Dir(path))
+	if err != nil {
+		return nil, st, errSambaPolicy
+	}
+	defer unix.Close(dir)
+	fd, err := unix.Openat(dir, filepath.Base(path), unix.O_RDONLY|unix.O_NONBLOCK|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0)
+	if err != nil {
+		return nil, st, errSambaPolicy
+	}
+	if unix.Fstat(fd, &st) != nil || !sambaFileTrusted(st, private) {
+		unix.Close(fd)
+		return nil, st, errSambaPolicy
+	}
+	return os.NewFile(uintptr(fd), "private-samba-policy"), st, nil
+}
+
+func sambaFileTrusted(st unix.Stat_t, private bool) bool {
+	return st.Uid == 0 && st.Mode&unix.S_IFMT == unix.S_IFREG && st.Mode&0022 == 0 && st.Mode&07000 == 0 && st.Nlink == 1 && (!private || st.Mode&0077 == 0)
+}
+
+func sambaPolicyRead() (string, error) {
+	file, before, err := sambaSafeFile("/etc/cupmemo/nas-samba.json", true)
+	if err != nil {
+		return "", errSambaPolicy
+	}
+	defer file.Close()
+	return sambaReadRecord(file, before, func() (unix.Stat_t, error) {
+		var after unix.Stat_t
+		err := unix.Fstat(int(file.Fd()), &after)
+		return after, err
+	})
+}
+
+func sambaReadRecord(reader io.Reader, before unix.Stat_t, stat func() (unix.Stat_t, error)) (string, error) {
+	if !sambaFileTrusted(before, true) {
+		return "", errSambaPolicy
+	}
+	if before.Size < 1 || before.Size > sambaPolicyLimit {
+		return "", errSambaPolicy
+	}
+	raw, err := io.ReadAll(io.LimitReader(reader, sambaPolicyLimit+1))
+	after, statErr := stat()
+	if err != nil || statErr != nil || len(raw) != int(before.Size) || len(raw) > sambaPolicyLimit || before.Dev != after.Dev || before.Ino != after.Ino || before.Size != after.Size || before.Mtim != after.Mtim || before.Ctim != after.Ctim || before.Mode != after.Mode || before.Uid != after.Uid || before.Nlink != after.Nlink {
+		return "", errSambaPolicy
+	}
+	fields, err := sambaStrictObject(raw, "canonicalNas")
+	if err != nil {
+		return "", errSambaPolicy
+	}
+	var canonical string
+	if json.Unmarshal(fields["canonicalNas"], &canonical) != nil || canonical == "" {
+		return "", errSambaPolicy
+	}
+	return canonical, nil
+}
+
+// Reject duplicate/unknown keys and trailing JSON, rather than last-key-wins.
+func sambaStrictObject(raw []byte, payload string) (map[string]json.RawMessage, error) {
+	if len(raw) > sambaPolicyLimit {
+		return nil, errSambaPolicy
+	}
+	dec := json.NewDecoder(bytes.NewReader(raw))
+	token, err := dec.Token()
+	if err != nil || token != json.Delim('{') {
+		return nil, errSambaPolicy
+	}
+	fields := map[string]json.RawMessage{}
+	for dec.More() {
+		key, err := dec.Token()
+		name, ok := key.(string)
+		if err != nil || !ok || (name != "version" && name != payload) {
+			return nil, errSambaPolicy
+		}
+		if _, exists := fields[name]; exists {
+			return nil, errSambaPolicy
+		}
+		var value json.RawMessage
+		if dec.Decode(&value) != nil {
+			return nil, errSambaPolicy
+		}
+		fields[name] = value
+	}
+	if token, err = dec.Token(); err != nil || token != json.Delim('}') || len(fields) != 2 {
+		return nil, errSambaPolicy
+	}
+	var extra interface{}
+	if dec.Decode(&extra) != io.EOF {
+		return nil, errSambaPolicy
+	}
+	var version int
+	if json.Unmarshal(fields["version"], &version) != nil || version != 1 {
+		return nil, errSambaPolicy
+	}
+	return fields, nil
+}
+
+// Do not embed bytes.Buffer: its promoted ReadFrom would bypass Write's cap
+// when os/exec copies the child's pipe using io.Copy.
+type sambaBoundedOutput struct{ buffer bytes.Buffer }
+
+func (b *sambaBoundedOutput) Write(p []byte) (int, error) {
+	if b.buffer.Len()+len(p) > sambaPolicyLimit {
+		return 0, errSambaPolicy
+	}
+	return b.buffer.Write(p)
+}
+
+func sambaCheckAdapter() error {
+	for _, path := range []string{"/usr/bin/node", "/usr/local/lib/cupmemo/samba-policy.mjs"} {
+		file, _, err := sambaSafeFile(path, false)
+		if err != nil {
+			return errSambaPolicy
+		}
+		file.Close()
+	}
+	return nil
+}
+
+func (p sambaPolicyDeps) transform(rows []model2.SharesDBModel, mutations []sambaMutation) (string, error) {
+	if len(rows) > 1024 || len(mutations) > 1024 {
+		return "", errSambaPolicy
+	}
+	canonical, err := p.read()
+	if err != nil {
+		return "", errSambaPolicy
+	}
+	if p.checkAdapter() != nil {
+		return "", errSambaPolicy
+	}
+	var generated strings.Builder
+	for _, row := range rows {
+		name := filepath.Base(row.Path)
+		generated.WriteString("\n[" + name + "]\ncomment = CasaOS share " + name + "\npublic = Yes\npath = " + row.Path + "\nbrowseable = Yes\nread only = No\nguest ok = Yes\ncreate mask = 0777\ndirectory mask = 0777\nforce user = root\n\n")
+		if generated.Len() > sambaPolicyLimit {
+			return "", errSambaPolicy
+		}
+	}
+	if mutations == nil {
+		mutations = []sambaMutation{}
+	}
+	request := struct {
+		Version      int             `json:"version"`
+		CanonicalNas string          `json:"canonicalNas"`
+		Generated    string          `json:"generated"`
+		Mutations    []sambaMutation `json:"mutations"`
+	}{1, canonical, generated.String(), mutations}
+	raw, err := json.Marshal(request)
+	if err != nil || len(raw) > sambaPolicyLimit {
+		return "", errSambaPolicy
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	output, err := p.run(ctx, raw)
+	if err != nil || ctx.Err() != nil {
+		return "", errSambaPolicy
+	}
+	fields, err := sambaStrictObject(output, "config")
+	if err != nil {
+		return "", errSambaPolicy
+	}
+	var config string
+	if json.Unmarshal(fields["config"], &config) != nil || config == "" || len(config) > sambaPolicyLimit {
+		return "", errSambaPolicy
+	}
+	return config, nil
+}
+
+func sambaAdapterRun(ctx context.Context, raw []byte) ([]byte, error) {
+	return sambaRunCommand(ctx, "/usr/bin/node", []string{"/usr/local/lib/cupmemo/samba-policy.mjs", "--transform"}, raw)
+}
+
+func sambaRunCommand(ctx context.Context, executable string, args []string, raw []byte) ([]byte, error) {
+	cmd := exec.CommandContext(ctx, executable, args...)
+	cmd.Env = []string{"PATH=/usr/bin:/bin", "LANG=C"}
+	cmd.Stdin = bytes.NewReader(raw)
+	var output sambaBoundedOutput
+	cmd.Stdout = &output
+	cmd.Stderr = io.Discard
+	cmd.WaitDelay = 250 * time.Millisecond
+	if cmd.Run() != nil || ctx.Err() != nil {
+		return nil, errSambaPolicy
+	}
+	return output.buffer.Bytes(), nil
+}
+
+func sambaMutationFor(operation string, row model2.SharesDBModel) []sambaMutation {
+	result := []sambaMutation{{operation, filepath.Base(row.Path), row.Path}}
+	if row.Name != "" {
+		result = append(result, sambaMutation{operation, row.Name, row.Path})
+	}
+	return result
+}
+
+// Atomic include replacement only. No root smb.conf initialization/rewriting.
+// Adapter validation happens before reaching this function. No symlink fallback.
+func sambaWriteInclude(config string) error {
+	dir, err := sambaSafeDirectory("/etc/samba")
+	if err != nil {
+		return errSambaPolicy
+	}
+	defer unix.Close(dir)
+	var st unix.Stat_t
+	err = unix.Fstatat(dir, "smb.casa.conf", &st, unix.AT_SYMLINK_NOFOLLOW)
+	if err != nil && err != unix.ENOENT {
+		return errSambaPolicy
+	}
+	if err == nil && (st.Uid != 0 || st.Mode&unix.S_IFMT != unix.S_IFREG || st.Mode&0022 != 0 || st.Nlink != 1) {
+		return errSambaPolicy
+	}
+	random := make([]byte, 16)
+	if _, err = rand.Read(random); err != nil {
+		return errSambaPolicy
+	}
+	name := ".cupmemo-" + hex.EncodeToString(random)
+	fd, err := unix.Openat(dir, name, unix.O_WRONLY|unix.O_CREAT|unix.O_EXCL|unix.O_CLOEXEC|unix.O_NOFOLLOW, 0600)
+	if err != nil {
+		return errSambaPolicy
+	}
+	defer unix.Unlinkat(dir, name, 0)
+	file := os.NewFile(uintptr(fd), "private-samba-include")
+	_, writeErr := io.WriteString(file, config)
+	syncErr := file.Sync()
+	closeErr := file.Close()
+	if writeErr != nil || syncErr != nil || closeErr != nil {
+		return errSambaPolicy
+	}
+	if unix.Renameat(dir, name, dir, "smb.casa.conf") != nil {
+		return errSambaPolicy
+	}
+	if unix.Fsync(dir) != nil {
+		return errSambaPolicy
+	}
+	return nil
+}
+
+func sambaReload() error {
+	ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, "/usr/bin/systemctl", "reload", "smbd")
+	cmd.Env = []string{"PATH=/usr/bin:/bin", "LANG=C"}
+	cmd.Stdout, cmd.Stderr = io.Discard, io.Discard
+	cmd.WaitDelay = 250 * time.Millisecond
+	if cmd.Run() != nil || ctx.Err() != nil {
+		return errSambaPolicy
+	}
+	return nil
+}
