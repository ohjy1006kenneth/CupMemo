+func TestSambaPolicyReadRecord(t *testing.T) {
+	raw, _ := json.Marshal(map[string]interface{}{"version": 1, "canonicalNas": sambaFixtureCanonical})
+	before := unix.Stat_t{Uid: 0, Mode: unix.S_IFREG | 0600, Nlink: 1, Size: int64(len(raw)), Dev: 1, Ino: 2}
+	value, err := sambaReadRecord(bytes.NewReader(raw), before, func() (unix.Stat_t, error) { return before, nil })
+	if err != nil || value != sambaFixtureCanonical {
+		t.Fatal("simulated root-owned stable read", err)
+	}
+	for _, change := range []string{"uid", "mode", "links", "size", "mtime", "stat", "short", "large", "null", "bad-json"} {
+		t.Run(change, func(t *testing.T) {
+			b, a := before, before
+			input := raw
+			statErr := error(nil)
+			switch change {
+			case "uid":
+				b.Uid = 1000
+			case "mode":
+				b.Mode |= 0040
+			case "links":
+				b.Nlink = 2
+			case "size":
+				a.Size++
+			case "mtime":
+				a.Mtim.Sec++
+			case "stat":
+				statErr = errors.New("SENTINEL")
