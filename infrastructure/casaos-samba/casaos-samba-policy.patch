+	t.Helper()
+	db, err := gorm.Open(sqlite.Open(filepath.Join(t.TempDir(), "fixture.sqlite")), &gorm.Config{Logger: logger.Default.LogMode(logger.Silent)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	sql, err := db.DB()
+	if err != nil {
+		t.Fatal(err)
+	}
+	sql.SetMaxOpenConns(1)
+	t.Cleanup(func() { sql.Close() })
+	if err = db.AutoMigrate(&model2.SharesDBModel{}); err != nil {
+		t.Fatal(err)
+	}
+	events := []string{}
+	written := ""
+	adapter, err := filepath.Abs("testdata/samba-policy.mjs")
+	if err != nil {
+		t.Fatal(err)
+	}
+	p := sambaPolicyDeps{
+		read:         func() (string, error) { return sambaFixtureCanonical, nil },
+		checkAdapter: func() error { return nil },
+		run: func(ctx context.Context, raw []byte) ([]byte, error) {
+			return sambaRunCommand(ctx, "/usr/bin/node", []string{adapter, "--transform"}, raw)
+		},
+		write:  func(s string) error { events = append(events, "write"); written = s; return nil },
+		reload: func() error { events = append(events, "reload"); return nil },
